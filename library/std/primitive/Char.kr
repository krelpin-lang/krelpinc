package std.primitive;

/**
 * The {@code char} primitive type, a Unicode scalar value.
 *
 * <p>A {@code char} holds any code point from {@code U+0000} to
 * {@code U+10FFFF} except the surrogates {@code U+D800} to {@code U+DFFF}.
 *
 * <p>The classification and case-mapping methods use the Unicode Character
 * Database built into the runtime, so their results are the same on every
 * platform and in every locale.
 *
 * <pre>{@code
 * 'ж'.isLetter()      // true
 * '٣'.isDigit()       // true, ARABIC-INDIC DIGIT THREE
 * 'ç'.toUpperCase()   // 'Ç'
 * }</pre>
 */
final class Char implements Comparable<char>, Hashable<char>, Cloneable<char> {
    /** The minimum value of a {@code char}, {@code U+0000}. */
    public static final char MIN_VALUE = '\u{0}';

    /** The maximum value of a {@code char}, {@code U+10FFFF}. */
    public static final char MAX_VALUE = '\u{10FFFF}';

    private Char() {}

    /**
     * Compares this character with another character by code point.
     *
     * @param other the character to compare with
     * @return a negative number, zero or a positive number if this character's
     *         code point is less than, equal to or greater than that of
     *         {@code other}
     */
    @Override
    int compareTo(&char other) {
        if (this < other) {
            return -1;
        }
        return this > other ? 1 : 0;
    }

    /**
     * Returns whether this character is a decimal digit in any script.
     *
     * @return {@code true} if the general category of this character is
     *         {@code Nd}
     */
    @Intrinsic
    boolean isDigit();

    /**
     * Returns whether this character is a letter.
     *
     * @return {@code true} if the general category of this character is one of
     *         the {@code L} categories
     */
    @Intrinsic
    boolean isLetter();

    /**
     * Returns whether this character is a letter or a decimal digit.
     *
     * @return {@code true} if {@link #isLetter} or {@link #isDigit} is
     *         {@code true}
     */
    @Intrinsic
    boolean isLetterOrDigit();

    /**
     * Returns whether this character is whitespace.
     *
     * <p>Whitespace includes the ASCII space, tab and line break characters, as
     * well as characters such as the no-break space {@code U+00A0}.
     *
     * @return {@code true} if this character has the Unicode
     *         {@code White_Space} property
     */
    @Intrinsic
    boolean isWhitespace();

    /**
     * Returns whether this character is an uppercase letter.
     *
     * @return {@code true} if the general category of this character is
     *         {@code Lu}
     */
    @Intrinsic
    boolean isUpperCase();

    /**
     * Returns whether this character is a lowercase letter.
     *
     * @return {@code true} if the general category of this character is
     *         {@code Ll}
     */
    @Intrinsic
    boolean isLowerCase();

    /**
     * Converts this character to uppercase.
     *
     * <p>A {@code char} can map only to a single {@code char}, so a character
     * whose uppercase form consists of several characters is returned
     * unchanged: {@code 'ß'.toUpperCase()} is {@code 'ß'}. Use
     * {@link String#toUpperCase} to obtain {@code "SS"}.
     *
     * @return the uppercase form of this character, or this character if it
     *         has none
     */
    @Intrinsic
    char toUpperCase();

    /**
     * Converts this character to lowercase.
     *
     * <p>The mapping does not depend on the locale: {@code 'I'} becomes
     * {@code 'i'}, not the dotless {@code 'ı'} used in Turkish.
     *
     * @return the lowercase form of this character, or this character if it
     *         has none
     */
    @Intrinsic
    char toLowerCase();

    /**
     * Returns whether this character is equal to another character.
     *
     * @param other the character to compare with
     * @return {@code true} if the characters are equal
     */
    @Override
    boolean equals(&char other) {
        return this == other;
    }

    /**
     * Returns a hash code for this character.
     *
     * @return the code point of this character
     */
    @Intrinsic
    @Override
    int hashCode();

    /**
     * Formats this character according to a format specification for text,
     * such as {@code "^3"}.
     *
     * @param spec the format specification, as described in {@link Format}
     * @return the formatted text
     * @throws IllegalArgumentException if {@code spec} is malformed or does
     *         not apply to text
     */
    @Override
    String format(String spec) {
        return Format.text("" + this, spec);
    }

    int digit(int radix) {
        if (radix < 2 || radix > 36) {
            throw new IllegalArgumentException("radix $radix is not between 2 and 36");
        }
        int value = -1;
        if (this >= '0' && this <= '9') {
            value = (int) this - (int) '0';
        } else if (this >= 'a' && this <= 'z') {
            value = (int) this - (int) 'a' + 10;
        } else if (this >= 'A' && this <= 'Z') {
            value = (int) this - (int) 'A' + 10;
        }
        return value < radix ? value : -1;
    }

    static char forDigit(int digit, int radix) {
        if (radix < 2 || radix > 36 || digit < 0 || digit >= radix) {
            throw new IllegalArgumentException("$digit is not a digit in radix $radix");
        }
        return digit < 10 ? (char) ((int) '0' + digit) : (char) ((int) 'a' + digit - 10);
    }

    @Override
    char clone() {
        return this;
    }
}
