package std.primitive;

/**
 * The {@code long} primitive type, a 64-bit signed two's complement integer.
 *
 * <p>The methods of this class are called on {@code long} values directly,
 * and its constants are accessed through the type name:
 *
 * <pre>{@code
 * long value = long.parse("9000000000");
 * String padded = value.format(">8");
 * }</pre>
 *
 * <p>Arithmetic on {@code long} wraps around on overflow:
 * {@code long.MAX_VALUE + 1} is {@code long.MIN_VALUE}.
 */
final class Long implements Comparable<long>, Hashable<long>, Cloneable<long> {
    /** The minimum value of a {@code long}, -2<sup>63</sup>. */
    public static final long MIN_VALUE = -9223372036854775808L;

    /**
     * The maximum value of a {@code long}, 2<sup>63</sup> - 1
     * (9223372036854775807).
     */
    public static final long MAX_VALUE = 9223372036854775807L;

    private Long() {}

    /**
     * Compares this value with another value numerically.
     *
     * @param other the value to compare with
     * @return a negative number, zero or a positive number if this value is
     *         less than, equal to or greater than {@code other}
     */
    int compareTo(&long other) {
        if (this < other) {
            return -1;
        }
        return this > other ? 1 : 0;
    }

    /**
     * Parses a signed decimal integer, such as {@code "9000000000"} or
     * {@code "+7"}.
     *
     * <p>The text may begin with {@code +} or {@code -} and must otherwise
     * consist only of the digits {@code 0} to {@code 9}. Whitespace,
     * underscores and radix prefixes such as {@code 0x} are not accepted.
     *
     * @param text the text to parse
     * @return the parsed value
     * @throws NumberFormatException if {@code text} is not a valid integer or
     *         its value does not fit in a {@code long}
     */
    @Intrinsic
    static long parse(String text);

    /**
     * Returns whether this value is equal to another value.
     *
     * @param other the value to compare with
     * @return {@code true} if the values are equal
     */
    boolean equals(&long other) {
        return this == other;
    }

    /**
     * Returns a hash code for this value, consistent with {@link #equals}.
     *
     * @return a hash code for this value
     */
    @Intrinsic
    int hashCode();

    /**
     * Formats this value according to a format specification.
     *
     * <p>{@code value.format(spec)} produces the same text as the
     * interpolation {@code "${value:spec}"}.
     *
     * <pre>{@code
     * 42.format(">6")  // "    42"
     * 42.format("06")  // "000042"
     * 255.format("x")  // "ff"
     * }</pre>
     *
     * @param spec the format specification, as described in {@link Format}
     * @return the formatted text
     * @throws IllegalArgumentException if {@code spec} is malformed or does
     *         not apply to integers
     */
    String format(String spec) {
        return Format.integer(this, spec);
    }

    static long parse(String text, int radix) {
        if (radix < 2 || radix > 36) {
            throw new IllegalArgumentException("radix $radix is not between 2 and 36");
        }
        char[] chars = text.chars();
        int start = 0;
        boolean negative = false;
        if (chars.length > 0 && (chars[0] == '-' || chars[0] == '+')) {
            negative = chars[0] == '-';
            start = 1;
        }
        if (start == chars.length) {
            throw new NumberFormatException("`$text` is not a number in radix $radix");
        }
        long limit = negative ? long.MIN_VALUE : -long.MAX_VALUE;
        long result = 0;
        for (int index = start; index < chars.length; index++) {
            int digit = chars[index].digit(radix);
            if (digit < 0) {
                throw new NumberFormatException("`$text` is not a number in radix $radix");
            }
            if (result < (limit + digit) / radix) {
                throw new NumberFormatException("`$text` does not fit in a `long`");
            }
            result = result * radix - digit;
        }
        return negative ? result : -result;
    }

    static String toString(long value, int radix) {
        if (radix < 2 || radix > 36) {
            throw new IllegalArgumentException("radix $radix is not between 2 and 36");
        }
        if (value == 0) {
            return "0";
        }
        StringBuilder digits = new StringBuilder();
        long rest = value;
        while (rest != 0) {
            int digit = (int) (rest % radix);
            digits.append("${Char.forDigit(digit < 0 ? -digit : digit, radix)}");
            rest = rest / radix;
        }
        if (value < 0) {
            digits.append("-");
        }
        digits.reverse();
        return digits.toString();
    }

    long clone() {
        return this;
    }
}
