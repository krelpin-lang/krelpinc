package std.primitive;

/**
 * The {@code double} primitive type, a 64-bit IEEE 754 floating-point number.
 *
 * <p>Arithmetic follows IEEE 754, so {@code double} has NaN ("not a number")
 * and infinite values. The operators {@code ==} and {@code <} treat NaN as
 * the standard requires: it is not equal to any value, including itself.
 * {@link #equals} and {@link #compareTo} instead define a total order, so
 * that floating-point numbers can be sorted and used as keys in a
 * {@code HashMap}:
 *
 * <ul>
 * <li>all NaN values are equal to each other and sort after every other
 *     value;
 * <li>{@code -0.0} sorts before {@code 0.0}, and the two are not equal.
 * </ul>
 *
 * <pre>{@code
 * double nan = 0.0 / 0.0;
 * nan == nan        // false
 * nan.equals(&nan)  // true
 * nan.isNaN()       // true
 * }</pre>
 */
final class Double implements Comparable<double>, Hashable<double>, Cloneable<double> {
    /** The smallest positive value of a {@code double}. */
    public static final double MIN_VALUE = 4.9e-324;

    /** The largest finite value of a {@code double}. */
    public static final double MAX_VALUE = 1.7976931348623157e308;

    private Double() {}

    /**
     * Returns whether this value is NaN.
     *
     * @return {@code true} if this value is NaN
     */
    boolean isNaN() {
        return this != this;
    }

    /**
     * Returns whether this value is infinite.
     *
     * @return {@code true} if this value is positive or negative infinity
     */
    boolean isInfinite() {
        return this == 1.0 / 0.0 || this == -1.0 / 0.0;
    }

    /**
     * Returns whether this value is finite.
     *
     * @return {@code true} if this value is neither infinite nor NaN
     */
    boolean isFinite() {
        return !this.isNaN() && !this.isInfinite();
    }

    /**
     * Compares this value with another value, using a total order.
     *
     * <p>NaN sorts after every other value and {@code -0.0} sorts before
     * {@code 0.0}; all other values are ordered as by {@code <} and {@code >}.
     *
     * @param other the value to compare with
     * @return a negative number, zero or a positive number if this value sorts
     *         before, equal to or after {@code other}
     */
    int compareTo(&double other) {
        if (this < other) {
            return -1;
        }
        if (this > other) {
            return 1;
        }
        boolean thisNaN = this != this;
        boolean otherNaN = other != other;
        if (thisNaN || otherNaN) {
            return thisNaN == otherNaN ? 0 : thisNaN ? 1 : -1;
        }
        if (this == 0.0) {
            // Both are zeros, possibly with different signs.
            double a = 1.0 / this;
            double b = 1.0 / other;
            return a < b ? -1 : a > b ? 1 : 0;
        }
        return 0;
    }

    /**
     * Parses a decimal floating-point number, such as {@code "3.25"},
     * {@code "-1e-9"} or {@code "inf"}.
     *
     * <p>The text consists of an optional sign followed by digits with an
     * optional fraction and exponent, or by {@code inf}, {@code infinity} or
     * {@code nan} in any case. Whitespace and hexadecimal notation are not
     * accepted.
     *
     * @param text the text to parse
     * @return the parsed value
     * @throws NumberFormatException if {@code text} is not a valid number
     */
    @Intrinsic
    static double parse(String text);

    /**
     * Returns whether this value is the same number as another value.
     *
     * <p>Unlike {@code ==}, NaN is equal to NaN and {@code 0.0} is not equal to
     * {@code -0.0}, which keeps this method consistent with {@link #hashCode}
     * and {@link #compareTo}.
     *
     * @param other the value to compare with
     * @return {@code true} if {@link #compareTo} returns 0
     */
    boolean equals(&double other) {
        return this.compareTo(other) == 0;
    }

    /**
     * Returns a hash code for this value, consistent with {@link #equals}.
     *
     * @return a hash code for this value
     */
    @Intrinsic
    int hashCode();

    /**
     * Formats this value according to a format specification.
     *
     * <p>{@code value.format(spec)} produces the same text as the
     * interpolation {@code "${value:spec}"}.
     *
     * <pre>{@code
     * 3.14159.format(".2")   // "3.14"
     * 2.5.format(">8.1")     // "     2.5"
     * }</pre>
     *
     * @param spec the format specification, as described in {@link Format}
     * @return the formatted text
     * @throws IllegalArgumentException if {@code spec} is malformed or does
     *         not apply to floating-point numbers
     */
    String format(String spec) {
        return Format.decimal(this, spec);
    }

    double clone() {
        return this;
    }
}
