package std.primitive;

/**
 * The {@code boolean} primitive type.
 *
 * <p>For ordering, {@code false} sorts before {@code true}.
 */
final class Boolean implements Comparable<boolean>, Hashable<boolean>, Cloneable<boolean> {
    private Boolean() {}

    /**
     * Compares this value with another value.
     *
     * @param other the value to compare with
     * @return 0 if the values are equal, -1 if this value is {@code false},
     *         and 1 if it is {@code true}
     */
    @Override
    int compareTo(&boolean other) {
        if (this == other) {
            return 0;
        }
        return this ? 1 : -1;
    }

    /**
     * Parses a boolean.
     *
     * <p>Only the exact strings {@code "true"} and {@code "false"} are
     * accepted; other capitalizations are rejected.
     *
     * @param text the text to parse
     * @return the parsed value
     * @throws IllegalArgumentException if {@code text} is neither
     *         {@code "true"} nor {@code "false"}
     */
    static boolean parse(String text) {
        if (text == "true") {
            return true;
        }
        if (text == "false") {
            return false;
        }
        throw new IllegalArgumentException("`$text` is not a boolean; expected `true` or `false`");
    }

    /**
     * Returns whether this value is equal to another value.
     *
     * @param other the value to compare with
     * @return {@code true} if the values are equal
     */
    @Override
    boolean equals(&boolean other) {
        return this == other;
    }

    /**
     * Returns a hash code for this value, consistent with {@link #equals}.
     *
     * @return a hash code for this value
     */
    @Intrinsic
    @Override
    int hashCode();

    /**
     * Formats {@code "true"} or {@code "false"} according to a format
     * specification for text, such as {@code ">6"}.
     *
     * @param spec the format specification, as described in {@link Format}
     * @return the formatted text
     * @throws IllegalArgumentException if {@code spec} is malformed or does
     *         not apply to text
     */
    @Override
    String format(String spec) {
        return Format.text("" + this, spec);
    }

    @Override
    boolean clone() {
        return this;
    }
}
