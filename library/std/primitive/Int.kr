package std.primitive;

/**
 * The {@code int} primitive type, a 32-bit signed two's complement integer.
 *
 * <p>The methods of this class are called on {@code int} values directly,
 * and its constants are accessed through the type name:
 *
 * <pre>{@code
 * int value = int.parse("-42");
 * String padded = value.format(">8");
 * }</pre>
 *
 * <p>Arithmetic on {@code int} wraps around on overflow:
 * {@code int.MAX_VALUE + 1} is {@code int.MIN_VALUE}.
 */
final class Int implements Comparable<int>, Hashable<int>, Cloneable<int> {
    /** The minimum value of an {@code int}, -2<sup>31</sup>. */
    public static final int MIN_VALUE = -2147483648;

    /** The maximum value of an {@code int}, 2<sup>31</sup> - 1 (2147483647). */
    public static final int MAX_VALUE = 2147483647;

    private Int() {}

    /**
     * Compares this value with another value numerically.
     *
     * @param other the value to compare with
     * @return a negative number, zero or a positive number if this value is
     *         less than, equal to or greater than {@code other}
     */
    @Override
    int compareTo(&int other) {
        if (this < other) {
            return -1;
        }
        return this > other ? 1 : 0;
    }

    /**
     * Parses a signed decimal integer, such as {@code "-42"} or {@code "+7"}.
     *
     * <p>The text may begin with {@code +} or {@code -} and must otherwise
     * consist only of the digits {@code 0} to {@code 9}. Whitespace,
     * underscores and radix prefixes such as {@code 0x} are not accepted.
     *
     * @param text the text to parse
     * @return the parsed value
     * @throws NumberFormatException if {@code text} is not a valid integer or
     *         its value does not fit in an {@code int}
     */
    @Intrinsic
    static int parse(String text);

    /**
     * Returns whether this value is equal to another value.
     *
     * @param other the value to compare with
     * @return {@code true} if the values are equal
     */
    @Override
    boolean equals(&int other) {
        return this == other;
    }

    /**
     * Returns a hash code for this value, consistent with {@link #equals}.
     *
     * @return a hash code for this value
     */
    @Intrinsic
    @Override
    int hashCode();

    /**
     * Formats this value according to a format specification.
     *
     * <p>{@code value.format(spec)} produces the same text as the
     * interpolation {@code "${value:spec}"}.
     *
     * <pre>{@code
     * 42.format(">6")  // "    42"
     * 42.format("06")  // "000042"
     * 255.format("x")  // "ff"
     * }</pre>
     *
     * @param spec the format specification, as described in {@link Format}
     * @return the formatted text
     * @throws IllegalArgumentException if {@code spec} is malformed or does
     *         not apply to integers
     */
    @Override
    String format(String spec) {
        return Format.integer(this, spec);
    }

    static int parse(String text, int radix) {
        long value = 0;
        try {
            value = Long.parse(text, radix);
        } catch (NumberFormatException error) {
            String? message = error.getMessage();
            if (message != null && message.contains("fit")) {
                throw new NumberFormatException("`$text` does not fit in an `int`");
            }
            throw error;
        }
        if (value < int.MIN_VALUE || value > int.MAX_VALUE) {
            throw new NumberFormatException("`$text` does not fit in an `int`");
        }
        return (int) value;
    }

    String toString(int radix) {
        return Long.toString((long) this, radix);
    }

    @Override
    int clone() {
        return this;
    }
}
