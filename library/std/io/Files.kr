package std.io;

/**
 * Static methods that read, write and inspect files as a whole.
 *
 * <p>Paths are strings and are relative to the current working directory
 * unless they begin with {@code /}. Text is encoded as UTF-8; reading a file
 * that is not valid UTF-8 throws an exception.
 *
 * <pre>{@code
 * Files.writeString("notes.txt", "first line\n");
 * Files.appendString("notes.txt", "second line\n");
 * for (String line : Files.readLines("notes.txt")) {
 *     Console.println(line);
 * }
 * }</pre>
 *
 * <p>Every method that can fail throws an {@link IOException} whose message
 * names the path and the reason, such as
 * {@code couldn't read `notes.txt`: No such file or directory}.
 *
 * @see FileReader
 * @see FileWriter
 * @see Path
 */
final class Files {
    private Files() {}

    /**
     * Reads the entire content of a file.
     *
     * @param path the path of the file
     * @return the content of the file
     * @throws IOException if the file cannot be read or is not valid UTF-8
     */
    static String readString(String path) throws IOException {
        String? text = readFile(path);
        if (text == null) {
            throw failure("read", path);
        }
        return text;
    }

    /**
     * Reads all lines of a file, split as by {@link String#lines}.
     *
     * @param path the path of the file
     * @return the lines of the file
     * @throws IOException if the file cannot be read or is not valid UTF-8
     */
    static String[] readLines(String path) throws IOException {
        return readString(path).lines();
    }

    /**
     * Writes text to a file, creating the file or replacing its content.
     *
     * @param path the path of the file
     * @param text the text to write
     * @throws IOException if the file cannot be written
     */
    static void writeString(String path, String text) throws IOException {
        if (!writeFile(path, text, false)) {
            throw failure("write", path);
        }
    }

    /**
     * Appends text to the end of a file, creating the file if it does not
     * exist.
     *
     * @param path the path of the file
     * @param text the text to append
     * @throws IOException if the file cannot be written
     */
    static void appendString(String path, String text) throws IOException {
        if (!writeFile(path, text, true)) {
            throw failure("append to", path);
        }
    }

    /**
     * Returns whether a file or directory exists at a path. This method never
     * throws.
     *
     * @param path the path to test
     * @return {@code true} if something exists at {@code path}
     */
    @Intrinsic
    static boolean exists(String path);

    /**
     * Returns whether a path names a regular file. This method never throws.
     *
     * @param path the path to test
     * @return {@code true} if {@code path} is a regular file
     */
    @Intrinsic
    static boolean isFile(String path);

    /**
     * Returns whether a path names a directory. This method never throws.
     *
     * @param path the path to test
     * @return {@code true} if {@code path} is a directory
     */
    @Intrinsic
    static boolean isDirectory(String path);

    /**
     * Returns the canonical form of a path: absolute, with every symbolic
     * link, {@code .} and {@code ..} resolved.
     *
     * @param path the path of an existing file or directory
     * @return the canonical path
     * @throws IOException if the path does not exist or cannot be resolved
     */
    static String canonicalPath(String path) throws IOException {
        String? canonical = canonicalize(path);
        if (canonical == null) {
            throw failure("resolve", path);
        }
        return canonical;
    }

    /**
     * Returns the size of a file.
     *
     * @param path the path of the file
     * @return the size of the file, in bytes
     * @throws IOException if the size cannot be read
     */
    static long size(String path) throws IOException {
        long size = sizeOf(path);
        if (size < 0) {
            throw failure("read the size of", path);
        }
        return size;
    }

    /**
     * Deletes a file or an empty directory.
     *
     * @param path the path to delete
     * @throws IOException if the path cannot be deleted
     */
    static void delete(String path) throws IOException {
        if (!remove(path)) {
            throw failure("delete", path);
        }
    }

    /**
     * Creates a directory, including any missing parent directories.
     *
     * <p>Succeeds without doing anything if the directory already exists.
     *
     * @param path the path of the directory
     * @throws IOException if a directory cannot be created
     */
    static void createDirectories(String path) throws IOException {
        if (!makeDirectories(path)) {
            throw failure("create the directory", path);
        }
    }

    /**
     * Returns the names of the entries in a directory.
     *
     * @param directory the path of the directory
     * @return the entry names in sorted order, excluding {@code .} and
     *         {@code ..}
     * @throws IOException if the directory cannot be read
     */
    static String[] list(String directory) throws IOException {
        String[]? names = listDirectory(directory);
        if (names == null) {
            throw failure("list", directory);
        }
        return names;
    }

    static byte[] readBytes(String path) throws IOException {
        byte[]? bytes = readBytesRaw(path);
        if (bytes == null) {
            throw failure("read", path);
        }
        return bytes;
    }

    static void writeBytes(String path, &byte[] bytes) throws IOException {
        if (!writeBytesRaw(path, bytes, false)) {
            throw failure("write", path);
        }
    }

    static void appendBytes(String path, &byte[] bytes) throws IOException {
        if (!writeBytesRaw(path, bytes, true)) {
            throw failure("append to", path);
        }
    }

    @Intrinsic
    static boolean isSymlink(String path);

    static long lastModified(String path) throws IOException {
        long millis = modifiedRaw(path);
        if (millis == long.MIN_VALUE) {
            throw failure("read the modification time of", path);
        }
        return millis;
    }

    static void setLastModified(String path, long millis) throws IOException {
        if (!setModifiedRaw(path, millis)) {
            throw failure("set the modification time of", path);
        }
    }

    static boolean isReadable(String path) {
        return accessRaw(path, 0);
    }

    static boolean isWritable(String path) {
        return accessRaw(path, 1);
    }

    static boolean isExecutable(String path) {
        return accessRaw(path, 2);
    }

    static void setReadable(String path, boolean readable) throws IOException {
        if (!setPermissionRaw(path, 0, readable)) {
            throw failure("change the permissions of", path);
        }
    }

    static void setWritable(String path, boolean writable) throws IOException {
        if (!setPermissionRaw(path, 1, writable)) {
            throw failure("change the permissions of", path);
        }
    }

    static void setExecutable(String path, boolean executable) throws IOException {
        if (!setPermissionRaw(path, 2, executable)) {
            throw failure("change the permissions of", path);
        }
    }

    static void createDirectory(String path) throws IOException {
        if (!makeDirectory(path)) {
            throw failure("create the directory", path);
        }
    }

    static void copy(String from, String to) throws IOException {
        if (!copyFile(from, to)) {
            throw new IOException("couldn't copy `$from` to `$to`: ${Files.lastError()}");
        }
    }

    static void move(String from, String to) throws IOException {
        if (!renameFile(from, to)) {
            throw new IOException("couldn't move `$from` to `$to`: ${Files.lastError()}");
        }
    }

    static void deleteRecursively(String path) throws IOException {
        if (isDirectory(path) && !isSymlink(path)) {
            for (String name : list(path)) {
                deleteRecursively(Path.join(path, name));
            }
        }
        delete(path);
    }

    static String tempDirectory() {
        String? configured = System.env("TMPDIR");
        if (configured == null || configured.isEmpty()) {
            return "/tmp";
        }
        String trimmed = configured;
        while (trimmed.length() > 1 && trimmed.endsWith("/")) {
            trimmed = trimmed.substring(0, trimmed.length() - 1);
        }
        return trimmed;
    }

    static String createTempDirectory(String prefix) throws IOException {
        String base = tempDirectory();
        long seed = System.nanoTime();
        for (int attempt = 0; attempt < 100; attempt++) {
            long tag = Math.abs(seed + attempt * 7919L);
            String candidate = Path.join(base, "$prefix$tag");
            if (makeDirectory(candidate)) {
                return candidate;
            }
            if (!exists(candidate)) {
                throw failure("create the directory", candidate);
            }
        }
        throw new IOException("couldn't create a temporary directory in `$base`");
    }

    private static IOException failure(String action, String path) {
        return new IOException("couldn't $action `$path`: ${Files.lastError()}");
    }

    @Intrinsic
    private static String? readFile(String path);

    @Intrinsic
    private static boolean writeFile(String path, String text, boolean append);

    @Intrinsic
    private static long sizeOf(String path);

    @Intrinsic
    private static long modifiedRaw(String path);

    @Intrinsic
    private static boolean setModifiedRaw(String path, long millis);

    @Intrinsic
    private static boolean accessRaw(String path, int mode);

    @Intrinsic
    private static boolean setPermissionRaw(String path, int mode, boolean on);

    @Intrinsic
    private static String? canonicalize(String path);

    @Intrinsic
    private static boolean remove(String path);

    @Intrinsic
    private static boolean makeDirectories(String path);

    @Intrinsic
    private static String[]? listDirectory(String path);

    @Intrinsic
    private static boolean makeDirectory(String path);

    @Intrinsic
    private static boolean renameFile(String from, String to);

    @Intrinsic
    private static boolean copyFile(String from, String to);

    @Intrinsic
    private static byte[]? readBytesRaw(String path);

    @Intrinsic
    private static boolean writeBytesRaw(String path, &byte[] bytes, boolean append);

    @Intrinsic
    private static String lastError();
}
