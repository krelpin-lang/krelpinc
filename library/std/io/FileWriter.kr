package std.io;

/**
 * Writes a text file sequentially, piece by piece.
 *
 * <pre>{@code
 * FileWriter out = FileWriter.create("report.txt");
 * out.writeLine("total: $total");
 * out.flush();
 * }</pre>
 *
 * <p>Writes are buffered, and {@link #flush} writes the buffered text to the
 * file. The writer is flushed and the file closed when the writer is
 * dropped, but any error at that point is lost, so call {@code flush}
 * explicitly when errors must be detected.
 *
 * @see Files
 */
final class FileWriter {
    private FileWriter() {}

    /**
     * Opens a file for writing, creating it or truncating its content.
     *
     * @param path the path of the file
     * @return a writer positioned at the beginning of the empty file
     * @throws IOException if the file cannot be opened
     */
    static FileWriter create(String path) throws IOException {
        return open(path, false);
    }

    /**
     * Opens a file for appending, creating it if it does not exist.
     *
     * @param path the path of the file
     * @return a writer positioned at the end of the file
     * @throws IOException if the file cannot be opened
     */
    static FileWriter append(String path) throws IOException {
        return open(path, true);
    }

    /**
     * Writes text.
     *
     * @param text the text to write
     * @throws IOException if writing fails
     */
    mut void write(String text) throws IOException {
        if (!this.writeRaw(text)) {
            throw new IOException("couldn't write: ${FileWriter.lastError()}");
        }
    }

    /**
     * Writes text followed by a line terminator ({@code \n}).
     *
     * @param text the text to write
     * @throws IOException if writing fails
     */
    mut void write(&byte[] bytes) throws IOException {
        if (!this.writeBytesRaw(bytes)) {
            throw new IOException("couldn't write: ${FileWriter.lastError()}");
        }
    }

    mut void writeLine(String text) throws IOException {
        this.write(text);
        this.write("\n");
    }

    /**
     * Writes all buffered text to the file.
     *
     * @throws IOException if writing fails
     */
    mut void flush() throws IOException {
        if (!this.flushRaw()) {
            throw new IOException("couldn't flush: ${FileWriter.lastError()}");
        }
    }

    private static FileWriter open(String path, boolean append) throws IOException {
        FileWriter writer = new FileWriter();
        if (!writer.openRaw(path, append)) {
            throw new IOException("couldn't open `$path`: ${FileWriter.lastError()}");
        }
        return writer;
    }

    @Intrinsic
    private mut boolean openRaw(String path, boolean append);

    @Intrinsic
    private mut boolean writeRaw(String text);

    @Intrinsic
    private mut boolean flushRaw();

    @Intrinsic
    private mut boolean writeBytesRaw(&byte[] bytes);

    @Intrinsic
    private static String lastError();
}
