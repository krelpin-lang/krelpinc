package std.sync;

/**
 * A mutual exclusion lock that protects a value, so that only one thread
 * at a time can access it.
 *
 * <p>{@link #lock} blocks until no other thread holds the lock and returns a
 * {@link Guard}. The protected value is accessed through the guard, and
 * the lock is released when the guard is dropped, so it cannot be left
 * locked by mistake:
 *
 * <pre>{@code
 * Mutex<List<String>> log = new Mutex<>(new ArrayList<>());
 * Guard<List<String>> guard = log.lock();
 * guard.getMut().add("started");
 * }</pre>
 *
 * <p>The lock is not reentrant: locking a mutex again on the thread that
 * already holds it deadlocks.
 *
 * @param <T> the type of the protected value
 */
final class Mutex<T> {
    private T value;

    /**
     * Constructs a mutex that owns a value.
     *
     * @param value the value to protect
     */
    Mutex(T value) {
        this.value = value;
    }

    /**
     * Acquires the lock, blocking until it is available.
     *
     * @return a guard that gives access to the value and releases the lock
     *         when dropped
     */
    @Intrinsic
    Guard<T> lock();

    @Intrinsic
    void notify();

    @Intrinsic
    void notifyAll();

    /**
     * Exclusive access to the value of a locked {@link Mutex}.
     *
     * <p>Dropping the guard releases the lock. The references a guard returns
     * cannot outlive it.
     *
     * @param <T> the type of the protected value
     */
    static final class Guard<T> borrows mutex {
        private Guard() {}

        /**
         * Returns the protected value.
         *
         * @return a reference to the value
         */
        @Intrinsic
        &T get();

        /**
         * Returns the protected value for modification.
         *
         * @return a mutable reference to the value
         */
        @Intrinsic
        mut &mut T getMut();

        @Intrinsic
        mut void wait();

        @Intrinsic
        mut boolean wait(long millis);
    }
}
