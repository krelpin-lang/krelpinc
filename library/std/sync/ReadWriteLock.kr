package std.sync;

final class ReadWriteLock<T> {
    private T value;

    ReadWriteLock(T value) {
        this.value = value;
    }

    @Intrinsic
    ReadGuard<T> read();

    @Intrinsic
    WriteGuard<T> write();

    static final class ReadGuard<T> borrows lock {
        private ReadGuard() {}

        @Intrinsic
        &T get();
    }

    static final class WriteGuard<T> borrows lock {
        private WriteGuard() {}

        @Intrinsic
        &T get();

        @Intrinsic
        mut &mut T getMut();
    }
}
