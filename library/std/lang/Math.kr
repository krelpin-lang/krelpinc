package std.lang;

/**
 * Basic numeric operations: absolute values, minimums and maximums,
 * rounding, roots, powers, logarithms and trigonometric functions.
 *
 * <p>Integer operations follow the arithmetic of the language and wrap
 * around on overflow. Floating-point operations follow IEEE 754: unless
 * stated otherwise, a NaN argument produces a NaN result.
 *
 * <pre>{@code
 * double side = Math.hypot(3.0, 4.0);       // 5.0
 * int percent = Math.clamp(130, 0, 100);    // 100
 * long rounded = Math.round(-2.5);          // -3
 * }</pre>
 */
final class Math {
    /** The ratio of a circle's circumference to its diameter. */
    public static final double PI = 3.141592653589793;

    /** The base of the natural logarithm. */
    public static final double E = 2.718281828459045;

    private Math() {}

    /**
     * Returns the absolute value of an {@code int}.
     *
     * <p>{@code Math.abs(int.MIN_VALUE)} is {@code int.MIN_VALUE}, because
     * its positive value cannot be represented as an {@code int}.
     *
     * @param value the value
     * @return the absolute value of {@code value}
     */
    static int abs(int value) {
        return value < 0 ? -value : value;
    }

    /**
     * Returns the absolute value of a {@code long}.
     *
     * <p>{@code Math.abs(long.MIN_VALUE)} is {@code long.MIN_VALUE}, because
     * its positive value cannot be represented as a {@code long}.
     *
     * @param value the value
     * @return the absolute value of {@code value}
     */
    static long abs(long value) {
        return value < 0 ? -value : value;
    }

    /**
     * Returns the absolute value of a {@code double}.
     *
     * @param value the value
     * @return the absolute value of {@code value}; {@code -0.0} becomes
     *         {@code 0.0}
     */
    static double abs(double value) {
        return value <= 0.0 ? 0.0 - value : value;
    }

    /**
     * Returns the smaller of two values.
     *
     * @param a the first value
     * @param b the second value
     * @return the smaller of {@code a} and {@code b}
     */
    static int min(int a, int b) {
        return a < b ? a : b;
    }

    /**
     * Returns the smaller of two values.
     *
     * @param a the first value
     * @param b the second value
     * @return the smaller of {@code a} and {@code b}
     */
    static long min(long a, long b) {
        return a < b ? a : b;
    }

    /**
     * Returns the smaller of two values.
     *
     * <p>NaN arguments are ignored: if one argument is NaN, the other is
     * returned, so the result is NaN only if both arguments are.
     *
     * <pre>{@code
     * Math.min(1.5, 0.0 / 0.0) // 1.5
     * }</pre>
     *
     * @param a the first value
     * @param b the second value
     * @return the smaller of {@code a} and {@code b}
     */
    static double min(double a, double b) {
        if (a != a) {
            return b;
        }
        if (b != b) {
            return a;
        }
        return a < b ? a : b;
    }

    /**
     * Returns the larger of two values.
     *
     * @param a the first value
     * @param b the second value
     * @return the larger of {@code a} and {@code b}
     */
    static int max(int a, int b) {
        return a > b ? a : b;
    }

    /**
     * Returns the larger of two values.
     *
     * @param a the first value
     * @param b the second value
     * @return the larger of {@code a} and {@code b}
     */
    static long max(long a, long b) {
        return a > b ? a : b;
    }

    /**
     * Returns the larger of two values.
     *
     * <p>NaN arguments are ignored, as in {@link #min(double, double)}.
     *
     * @param a the first value
     * @param b the second value
     * @return the larger of {@code a} and {@code b}
     */
    static double max(double a, double b) {
        if (a != a) {
            return b;
        }
        if (b != b) {
            return a;
        }
        return a > b ? a : b;
    }

    /**
     * Restricts a value to an inclusive range.
     *
     * <pre>{@code
     * Math.clamp(-4, 0, 10) // 0
     * Math.clamp(7, 0, 10)  // 7
     * }</pre>
     *
     * @param value the value to restrict
     * @param low the lower bound, inclusive
     * @param high the upper bound, inclusive
     * @return {@code low} if {@code value} is below it, {@code high} if
     *         {@code value} is above it, and {@code value} otherwise
     * @throws IllegalArgumentException if {@code low} is greater than
     *         {@code high}
     */
    static int clamp(int value, int low, int high) {
        if (low > high) {
            throw new IllegalArgumentException("clamp: the low bound $low is above the high bound $high");
        }
        return value < low ? low : value > high ? high : value;
    }

    /**
     * Restricts a value to an inclusive range.
     *
     * @param value the value to restrict
     * @param low the lower bound, inclusive
     * @param high the upper bound, inclusive
     * @return {@code value} restricted to the range
     * @throws IllegalArgumentException if {@code low} is greater than
     *         {@code high}
     */
    static long clamp(long value, long low, long high) {
        if (low > high) {
            throw new IllegalArgumentException("clamp: the low bound $low is above the high bound $high");
        }
        return value < low ? low : value > high ? high : value;
    }

    /**
     * Restricts a value to an inclusive range.
     *
     * @param value the value to restrict
     * @param low the lower bound, inclusive
     * @param high the upper bound, inclusive
     * @return {@code value} restricted to the range, or NaN if
     *         {@code value} is NaN
     * @throws IllegalArgumentException if {@code low} is greater than
     *         {@code high}, or if either bound is NaN
     */
    static double clamp(double value, double low, double high) {
        if (!(low <= high)) {
            throw new IllegalArgumentException("clamp: the bounds $low and $high don't form a range");
        }
        return value < low ? low : value > high ? high : value;
    }

    /**
     * Returns the sign of a value.
     *
     * @param value the value
     * @return -1, 0 or 1 if {@code value} is negative, zero or positive
     */
    static int signum(int value) {
        return value < 0 ? -1 : value > 0 ? 1 : 0;
    }

    /**
     * Returns the sign of a value.
     *
     * @param value the value
     * @return -1, 0 or 1 if {@code value} is negative, zero or positive
     */
    static int signum(long value) {
        return value < 0 ? -1 : value > 0 ? 1 : 0;
    }

    /**
     * Returns the sign of a value.
     *
     * @param value the value
     * @return -1.0 if {@code value} is negative, 1.0 if it is positive, and
     *         {@code value} itself if it is zero or NaN
     */
    static double signum(double value) {
        return value < 0.0 ? -1.0 : value > 0.0 ? 1.0 : value;
    }

    /**
     * Returns the square root of a value.
     *
     * <pre>{@code
     * Math.sqrt(2.0) // 1.4142135623730951
     * }</pre>
     *
     * @param value the value
     * @return the positive square root of {@code value}, or NaN if it is
     *         negative
     */
    @Intrinsic
    static double sqrt(double value);

    /**
     * Returns the cube root of a value.
     *
     * @param value the value, which may be negative
     * @return the cube root of {@code value}
     */
    @Intrinsic
    static double cbrt(double value);

    /**
     * Returns a value raised to a power.
     *
     * @param base the base
     * @param exponent the exponent
     * @return {@code base} raised to the power {@code exponent}
     */
    @Intrinsic
    static double pow(double base, double exponent);

    /**
     * Returns {@code sqrt(x * x + y * y)} without intermediate overflow or
     * underflow.
     *
     * @param x the first value
     * @param y the second value
     * @return the length of the hypotenuse
     */
    @Intrinsic
    static double hypot(double x, double y);

    /**
     * Returns Euler's number raised to a power.
     *
     * @param value the exponent
     * @return {@link #E} raised to the power {@code value}
     */
    @Intrinsic
    static double exp(double value);

    /**
     * Returns the natural logarithm of a value.
     *
     * @param value the value
     * @return the natural logarithm of {@code value}, or NaN if it is
     *         negative
     */
    @Intrinsic
    static double ln(double value);

    /**
     * Returns the base-10 logarithm of a value.
     *
     * @param value the value
     * @return the base-10 logarithm of {@code value}, or NaN if it is
     *         negative
     */
    @Intrinsic
    static double log10(double value);

    /**
     * Returns the base-2 logarithm of a value.
     *
     * @param value the value
     * @return the base-2 logarithm of {@code value}, or NaN if it is
     *         negative
     */
    @Intrinsic
    static double log2(double value);

    /**
     * Rounds a value down.
     *
     * @param value the value
     * @return the largest integral value that is not greater than
     *         {@code value}
     */
    @Intrinsic
    static double floor(double value);

    /**
     * Rounds a value up.
     *
     * @param value the value
     * @return the smallest integral value that is not less than
     *         {@code value}
     */
    @Intrinsic
    static double ceil(double value);

    /**
     * Rounds a value towards zero.
     *
     * @param value the value
     * @return {@code value} without its fractional part
     */
    @Intrinsic
    static double trunc(double value);

    /**
     * Rounds a value to the nearest {@code long}, with ties rounding away
     * from zero.
     *
     * <pre>{@code
     * Math.round(2.5)  // 3
     * Math.round(-2.5) // -3
     * Math.round(0.49999999999999994) // 0
     * }</pre>
     *
     * @param value the value to round
     * @return the nearest {@code long}; 0 if {@code value} is NaN, and
     *         {@code long.MIN_VALUE} or {@code long.MAX_VALUE} if it is
     *         outside the range of {@code long}
     */
    @Intrinsic
    static long round(double value);

    /**
     * Returns the sine of an angle.
     *
     * @param radians the angle, in radians
     * @return the sine of the angle
     */
    @Intrinsic
    static double sin(double radians);

    /**
     * Returns the cosine of an angle.
     *
     * @param radians the angle, in radians
     * @return the cosine of the angle
     */
    @Intrinsic
    static double cos(double radians);

    /**
     * Returns the tangent of an angle.
     *
     * @param radians the angle, in radians
     * @return the tangent of the angle
     */
    @Intrinsic
    static double tan(double radians);

    /**
     * Returns the arcsine of a value.
     *
     * @param value the value
     * @return the angle in radians, from {@code -PI / 2} to {@code PI / 2}
     */
    @Intrinsic
    static double asin(double value);

    /**
     * Returns the arccosine of a value.
     *
     * @param value the value
     * @return the angle in radians, from 0 to {@link #PI}
     */
    @Intrinsic
    static double acos(double value);

    /**
     * Returns the arctangent of a value.
     *
     * @param value the value
     * @return the angle in radians, from {@code -PI / 2} to {@code PI / 2}
     */
    @Intrinsic
    static double atan(double value);

    /**
     * Returns the angle between the positive x axis and the point
     * {@code (x, y)}.
     *
     * <pre>{@code
     * Math.atan2(1.0, 1.0) // 0.7853981633974483, which is PI / 4
     * }</pre>
     *
     * @param y the y coordinate
     * @param x the x coordinate
     * @return the angle in radians, from {@code -PI} to {@link #PI}
     */
    @Intrinsic
    static double atan2(double y, double x);

    /**
     * Converts an angle from degrees to radians.
     *
     * @param degrees the angle, in degrees
     * @return the angle, in radians
     */
    static double toRadians(double degrees) {
        return degrees * (Math.PI / 180.0);
    }

    /**
     * Converts an angle from radians to degrees.
     *
     * @param radians the angle, in radians
     * @return the angle, in degrees
     */
    static double toDegrees(double radians) {
        return radians * (180.0 / Math.PI);
    }

    /**
     * Returns a pseudo-random number greater than or equal to 0.0 and less
     * than 1.0.
     *
     * <p>Each thread has its own generator, seeded from the clock. The
     * generator is fast but predictable and must not be used for
     * security-sensitive purposes.
     *
     * @return a pseudo-random number in the range [0.0, 1.0)
     */
    @Intrinsic
    static double random();

    static int addExact(int a, int b) {
        int result = a + b;
        if (((a ^ result) & (b ^ result)) < 0) {
            throw new ArithmeticException("`int` overflow in $a + $b");
        }
        return result;
    }

    static long addExact(long a, long b) {
        long result = a + b;
        if (((a ^ result) & (b ^ result)) < 0) {
            throw new ArithmeticException("`long` overflow in $a + $b");
        }
        return result;
    }

    static int subtractExact(int a, int b) {
        int result = a - b;
        if (((a ^ b) & (a ^ result)) < 0) {
            throw new ArithmeticException("`int` overflow in $a - $b");
        }
        return result;
    }

    static long subtractExact(long a, long b) {
        long result = a - b;
        if (((a ^ b) & (a ^ result)) < 0) {
            throw new ArithmeticException("`long` overflow in $a - $b");
        }
        return result;
    }

    static int multiplyExact(int a, int b) {
        long result = (long) a * (long) b;
        if (result < int.MIN_VALUE || result > int.MAX_VALUE) {
            throw new ArithmeticException("`int` overflow in $a * $b");
        }
        return (int) result;
    }

    static long multiplyExact(long a, long b) {
        long result = a * b;
        if ((a != 0 && result / a != b) || (a == -1 && b == long.MIN_VALUE)) {
            throw new ArithmeticException("`long` overflow in $a * $b");
        }
        return result;
    }

    static int floorDiv(int value, int divisor) {
        int quotient = value / divisor;
        return (value % divisor != 0 && ((value ^ divisor) < 0)) ? quotient - 1 : quotient;
    }

    static long floorDiv(long value, long divisor) {
        long quotient = value / divisor;
        return (value % divisor != 0 && ((value ^ divisor) < 0)) ? quotient - 1 : quotient;
    }

    static int floorMod(int value, int divisor) {
        int rest = value % divisor;
        return rest != 0 && ((rest ^ divisor) < 0) ? rest + divisor : rest;
    }

    static long floorMod(long value, long divisor) {
        long rest = value % divisor;
        return rest != 0 && ((rest ^ divisor) < 0) ? rest + divisor : rest;
    }
}
