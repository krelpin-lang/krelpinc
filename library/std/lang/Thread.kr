package std.lang;

import std.function.Supplier;

/**
 * A thread of execution that runs a task concurrently with the rest of the
 * program.
 *
 * <pre>{@code
 * Thread worker = new Thread(() -> Console.println("working"));
 * worker.start();
 * worker.join();
 * }</pre>
 *
 * <p>An exception that escapes the task is written to standard error and
 * terminates only that thread. Threads share data through the types in
 * {@code std.sync}.
 *
 * @see Runnable
 */
final class Thread {
    private final Runnable task;

    /**
     * Constructs a thread that runs a task once it is started.
     *
     * @param task the task to run
     */
    Thread(Runnable task) {
        this.task = task;
    }

    /** Starts running the task on a new thread. */
    @Intrinsic
    mut void start();

    /** Waits for the task to finish. */
    @Intrinsic
    mut void join();

    /**
     * Suspends the current thread for at least the specified time.
     *
     * @param millis the time to sleep, in milliseconds
     */
    @Intrinsic
    static void sleep(long millis);

    @Intrinsic
    static long currentId();

    static final class Task<T> implements Runnable {
        private final Supplier<T> work;
        private T? result;

        Task(Supplier<T> work) {
            this.work = work;
            this.result = null;
        }

        @Override
        mut void run() {
            this.result = this.work.get();
        }

        @Intrinsic
        mut void start();

        mut T join() {
            this.joinRaw();
            T? value = this.result;
            this.result = null;
            if (value == null) {
                throw new IllegalStateException("the task has no value: it was never started, it threw, or it was already joined");
            }
            return value;
        }

        @Intrinsic
        private mut void joinRaw();
    }
}
