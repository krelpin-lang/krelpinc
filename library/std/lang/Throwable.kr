package std.lang;

/**
 * The superclass of all errors and exceptions.
 *
 * <p>Only instances of this class or its subclasses can be thrown by a
 * {@code throw} statement or caught by a {@code catch} clause. A throwable
 * that is not caught terminates the program: its type and message are
 * written to standard error, and the program exits with status 1.
 *
 * <pre>{@code
 * try {
 *     int count = int.parse(text);
 * } catch (NumberFormatException e) {
 *     Console.eprintln("not a number: ${e.getMessage()}");
 * }
 * }</pre>
 *
 * <p>Subclass {@link Exception} for conditions a caller is expected to
 * handle, {@link RuntimeException} for programming errors, and
 * {@link Error} for failures that should not be caught.
 */
class Throwable {
    private final String? message;

    /** Constructs a throwable with no detail message. */
    Throwable() {
        this.message = null;
    }

    /**
     * Constructs a throwable with the specified detail message.
     *
     * @param message the detail message, which describes what went wrong
     */
    Throwable(String message) {
        this.message = message;
    }

    /**
     * Returns the detail message of this throwable.
     *
     * @return the detail message, or {@code null} if there is none
     */
    String? getMessage() {
        return this.message;
    }
}
