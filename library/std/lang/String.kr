package std.lang;

import std.regex.Pattern;
import std.util.ArrayList;
import std.util.List;

/**
 * An immutable sequence of Unicode characters, encoded as UTF-8.
 *
 * <p>Lengths and indices count characters (Unicode scalar values), not
 * bytes: {@code "héllo".length()} is 5 and {@code "héllo".charAt(1)} is
 * {@code 'é'}. Strings are shared rather than copied, so passing one is
 * inexpensive.
 *
 * <p>Strings are usually built with the {@code +} operator, which converts
 * any value to text, or with string interpolation:
 *
 * <pre>{@code
 * String name = "Krelpin";
 * int version = 2;
 * String title = "$name v$version";          // "Krelpin v2"
 * String padded = "[${name:>10}]";           // "[   Krelpin]"
 * }</pre>
 *
 * <p>To build a long string from many pieces, use a {@link StringBuilder}.
 *
 * @see StringBuilder
 * @see Format
 */
final class String implements Comparable<String>, Hashable<String>, Cloneable<String> {
    /**
     * Returns the length of this string.
     *
     * @return the number of characters in this string
     */
    @Intrinsic
    int length();

    /**
     * Returns whether this string is empty.
     *
     * @return {@code true} if {@link #length} is 0
     */
    boolean isEmpty() {
        return this.length() == 0;
    }

    /**
     * Returns whether this string is empty or contains only whitespace.
     *
     * @return {@code true} if every character is whitespace, as defined by
     *         {@link std.primitive.Char#isWhitespace}
     */
    boolean isBlank() {
        return this.trim().isEmpty();
    }

    /**
     * Returns the characters of this string.
     *
     * @return a new array containing the characters of this string
     */
    @Intrinsic
    char[] chars();

    /**
     * Returns the UTF-8 encoding of this string.
     *
     * <pre>{@code
     * "hé".bytes() // [104, -61, -87]
     * }</pre>
     *
     * @return a new array containing the UTF-8 bytes of this string
     */
    @Intrinsic
    byte[] bytes();

    /**
     * Decodes a string from UTF-8 bytes.
     *
     * <pre>{@code
     * byte[] data = "hé".bytes();
     * String.fromUtf8(&data) // "hé"
     * }</pre>
     *
     * @param bytes the bytes to decode
     * @return the decoded string, or {@code null} if {@code bytes} is not
     *         valid UTF-8
     */
    @Intrinsic
    static String? fromUtf8(&byte[] bytes);

    /**
     * Returns the character at the specified index.
     *
     * <p>For strings that contain non-ASCII characters, this method scans
     * the string from the beginning. Use {@link #chars} to visit every
     * character of a long string.
     *
     * @param index the zero-based index of the character
     * @return the character at {@code index}
     * @throws IndexOutOfBoundsException if {@code index} is negative or not
     *         less than {@link #length}
     */
    @Intrinsic
    char charAt(int index);

    /**
     * Returns the substring that begins at the specified index and extends
     * to the end of this string.
     *
     * @param begin the index of the first character, inclusive
     * @return the substring
     * @throws IndexOutOfBoundsException if {@code begin} is negative or
     *         greater than {@link #length}
     */
    @Intrinsic
    String substring(int begin);

    /**
     * Returns the substring between two indices.
     *
     * <pre>{@code
     * "Krelpin".substring(1, 4) // "rel"
     * }</pre>
     *
     * @param begin the index of the first character, inclusive
     * @param end the index after the last character, exclusive
     * @return the substring
     * @throws IndexOutOfBoundsException unless
     *         {@code 0 <= begin <= end <= length()}
     */
    @Intrinsic
    String substring(int begin, int end);

    /**
     * Returns the index of the first occurrence of the specified text.
     *
     * @param text the text to search for; an empty string is found at
     *        index 0
     * @return the index of the first occurrence, or -1 if there is none
     */
    @Intrinsic
    int indexOf(String text);

    /**
     * Returns the index of the first occurrence of the specified text,
     * starting the search at the specified index.
     *
     * @param text the text to search for
     * @param from the index to start the search at; a negative value is
     *        treated as 0
     * @return the index of the first occurrence at or after {@code from}, or
     *         -1 if there is none
     */
    @Intrinsic
    int indexOf(String text, int from);

    /**
     * Returns the index of the last occurrence of the specified text.
     *
     * @param text the text to search for; an empty string is found at
     *        {@link #length}
     * @return the index of the last occurrence, or -1 if there is none
     */
    @Intrinsic
    int lastIndexOf(String text);

    /**
     * Returns whether this string contains the specified text.
     *
     * @param text the text to search for
     * @return {@code true} if {@code text} occurs in this string
     */
    boolean contains(String text) {
        return this.indexOf(text) >= 0;
    }

    /**
     * Returns whether this string starts with the specified prefix.
     *
     * @param prefix the prefix to test
     * @return {@code true} if this string starts with {@code prefix}
     */
    @Intrinsic
    boolean startsWith(String prefix);

    /**
     * Returns whether this string ends with the specified suffix.
     *
     * @param suffix the suffix to test
     * @return {@code true} if this string ends with {@code suffix}
     */
    @Intrinsic
    boolean endsWith(String suffix);

    /**
     * Returns this string with the specified prefix removed.
     *
     * <pre>{@code
     * "v1.2".stripPrefix("v")  // "1.2"
     * "1.2".stripPrefix("v")   // null
     * }</pre>
     *
     * @param prefix the prefix to remove
     * @return the rest of the string, or {@code null} if this string does
     *         not start with {@code prefix}
     */
    String? stripPrefix(String prefix) {
        if (!this.startsWith(prefix)) {
            return null;
        }
        return this.substring(prefix.length());
    }

    /**
     * Returns this string with the specified suffix removed.
     *
     * @param suffix the suffix to remove
     * @return the rest of the string, or {@code null} if this string does
     *         not end with {@code suffix}
     */
    String? stripSuffix(String suffix) {
        if (!this.endsWith(suffix)) {
            return null;
        }
        return this.substring(0, this.length() - suffix.length());
    }

    /**
     * Converts this string to uppercase.
     *
     * <p>The full Unicode case mappings are used, which can change the
     * length of the string: {@code "straße".toUpperCase()} is
     * {@code "STRASSE"}. The result does not depend on the locale.
     *
     * @return this string in uppercase
     */
    @Intrinsic
    String toUpperCase();

    /**
     * Converts this string to lowercase, using the full Unicode case
     * mappings as {@link #toUpperCase} does.
     *
     * @return this string in lowercase
     */
    @Intrinsic
    String toLowerCase();

    /**
     * Removes whitespace from both ends of this string.
     *
     * <p>Whitespace is any character with the Unicode {@code White_Space}
     * property.
     *
     * <pre>{@code
     * "  hello\n".trim() // "hello"
     * }</pre>
     *
     * @return this string without leading and trailing whitespace
     */
    @Intrinsic
    String trim();

    /**
     * Removes whitespace from the beginning of this string.
     *
     * @return this string without leading whitespace
     */
    @Intrinsic
    String trimStart();

    /**
     * Removes whitespace from the end of this string.
     *
     * @return this string without trailing whitespace
     */
    @Intrinsic
    String trimEnd();

    /**
     * Compares this string with another string, ignoring case.
     *
     * @param other the string to compare with
     * @return {@code true} if both strings are equal after conversion to
     *         lowercase
     */
    boolean equalsIgnoreCase(&String other) {
        return this.toLowerCase().equals(&other.toLowerCase());
    }

    /**
     * Splits this string into lines.
     *
     * <p>Lines are terminated by {@code \n} or {@code \r\n}; the terminators
     * are not included in the result. A terminator at the end of the string
     * does not start an additional empty line.
     *
     * <pre>{@code
     * "one\ntwo\r\n".lines() // ["one", "two"]
     * }</pre>
     *
     * @return the lines of this string
     */
    String[] lines() {
        String[] parts = this.replace("\r\n", "\n").split("\n");
        int count = parts.length;
        if (count > 0 && parts[count - 1].isEmpty()) {
            count--;
        }
        String[] lines = new String[count];
        for (int i = 0; i < count; i++) {
            lines[i] = parts[i];
        }
        return lines;
    }

    /**
     * Replaces every occurrence of a target string, from left to right.
     *
     * @param target the text to replace; if it is empty, nothing is replaced
     * @param replacement the text to insert in its place
     * @return the resulting string
     */
    @Intrinsic
    String replace(String target, String replacement);

    /**
     * Returns this string repeated the specified number of times.
     *
     * @param count the number of repetitions
     * @return the repeated string, or an empty string if {@code count} is 0
     * @throws IllegalArgumentException if {@code count} is negative
     */
    @Intrinsic
    String repeat(int count);

    /**
     * Splits this string around each occurrence of a separator.
     *
     * <p>Empty pieces are kept, so the result always has one more element
     * than there are separators. An empty separator splits the string into
     * its characters.
     *
     * <pre>{@code
     * "a,b,,c".split(",") // ["a", "b", "", "c"]
     * "abc".split("")     // ["a", "b", "c"]
     * }</pre>
     *
     * @param separator the separator
     * @return the pieces of this string
     */
    @Intrinsic
    String[] split(String separator);

    /**
     * Compares this string with another string lexicographically, by code
     * point.
     *
     * @param other the string to compare with
     * @return a negative number, zero or a positive number if this string
     *         sorts before, equal to or after {@code other}
     */
    @Intrinsic
    @Override
    int compareTo(&String other);

    /**
     * Returns whether this string contains the same characters as another
     * string.
     *
     * @param other the string to compare with
     * @return {@code true} if the strings are equal
     */
    @Intrinsic
    @Override
    boolean equals(&String other);

    /**
     * Returns a hash code for this string, consistent with {@link #equals}.
     *
     * @return a hash code for this string
     */
    @Intrinsic
    @Override
    int hashCode();

    /**
     * Joins strings with a separator between them.
     *
     * <pre>{@code
     * String.join(", ", "a", "b", "c") // "a, b, c"
     * }</pre>
     *
     * @param separator the text to insert between consecutive parts
     * @param parts the strings to join
     * @return the joined string
     */
    @Intrinsic
    static String join(String separator, String... parts);

    static String join(String separator, &List<String> parts) {
        StringBuilder text = new StringBuilder();
        for (int index = 0; index < parts.size(); index++) {
            if (index > 0) {
                text.append(separator);
            }
            text.append(parts.get(index));
        }
        return text.toString();
    }

    int indexOf(char c) {
        return this.indexOf("$c");
    }

    boolean contains(char c) {
        return this.indexOf(c) >= 0;
    }

    String[] split(String separator, int limit) {
        if (limit <= 0 || separator.isEmpty()) {
            return this.split(separator);
        }
        List<String> parts = new ArrayList<>();
        int from = 0;
        while (parts.size() < limit - 1) {
            int at = this.indexOf(separator, from);
            if (at < 0) {
                break;
            }
            parts.add(this.substring(from, at));
            from = at + separator.length();
        }
        parts.add(this.substring(from));
        String[] result = new String[parts.size()];
        for (int index = parts.size() - 1; index >= 0; index--) {
            result[index] = parts.remove(index);
        }
        return result;
    }

    /**
     * Returns the string representation of a value, as produced by string
     * concatenation.
     *
     * @param value the value to convert
     * @return the value as text, or {@code "null"} if it is {@code null}
     */
    @Intrinsic
    static String valueOf(Object? value);

    @Override
    String clone() {
        return this;
    }

    boolean matches(String regex) {
        return Pattern.matches(regex, this);
    }

    String replaceAll(String regex, String replacement) {
        Pattern pattern = Pattern.compile(regex);
        return pattern.matcher(this).replaceAll(replacement);
    }

    String replaceFirst(String regex, String replacement) {
        Pattern pattern = Pattern.compile(regex);
        return pattern.matcher(this).replaceFirst(replacement);
    }
}
