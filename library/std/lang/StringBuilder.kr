package std.lang;

/**
 * A mutable sequence of characters, for building a string from many pieces
 * without creating an intermediate {@link String} for each one.
 *
 * <pre>{@code
 * StringBuilder out = new StringBuilder();
 * for (int i = 0; i < 3; i++) {
 *     out.append("line $i");
 *     out.append('\n');
 * }
 * String text = out.toString();
 * }</pre>
 *
 * <p>As with {@code String}, lengths and indices count characters, not
 * bytes.
 */
final class StringBuilder {
    /** Constructs an empty string builder. */
    StringBuilder() {}

    /**
     * Appends a string.
     *
     * @param text the string to append
     */
    @Intrinsic
    mut void append(String text);

    /**
     * Appends a character.
     *
     * @param c the character to append
     */
    mut void append(char c) {
        this.append("" + c);
    }

    /**
     * Appends a string followed by a line separator ({@code \n}).
     *
     * @param text the string to append
     */
    mut void appendLine(String text) {
        this.append(text);
        this.append("\n");
    }

    /**
     * Returns the number of characters in this builder.
     *
     * @return the current length
     */
    @Intrinsic
    int length();

    /**
     * Returns whether this builder is empty.
     *
     * @return {@code true} if {@link #length} is 0
     */
    boolean isEmpty() {
        return this.length() == 0;
    }

    /**
     * Inserts a string at the specified index.
     *
     * @param index the index to insert at; {@link #length} appends
     * @param text the string to insert
     * @throws IndexOutOfBoundsException if {@code index} is negative or
     *         greater than {@link #length}
     */
    @Intrinsic
    mut void insert(int index, String text);

    /**
     * Shortens this builder to the specified length.
     *
     * @param length the number of characters to keep
     * @throws IndexOutOfBoundsException if {@code length} is negative or
     *         greater than the current length
     */
    @Intrinsic
    mut void truncate(int length);

    /** Reverses the order of the characters in this builder. */
    @Intrinsic
    mut void reverse();

    /** Removes all characters, keeping the allocated memory for reuse. */
    @Intrinsic
    mut void clear();

    /**
     * Returns the characters of this builder as a string.
     *
     * @return a new string containing the current contents
     */
    @Intrinsic
    @Override
    String toString();
}
