package std.util;

/**
 * A hash table implementation of {@link Set}.
 *
 * <p>{@link #add}, {@link #remove} and {@link #contains} run in constant
 * time on average. The iteration order of the elements is unspecified and
 * may change as elements are added or removed.
 *
 * @param <T> the type of the elements, which must be {@link Hashable}
 */
class HashSet<T extends Hashable<T>> implements Set<T> {
    /** Constructs an empty set. */
    HashSet() {}

    @Intrinsic
    int size();

    @Intrinsic
    mut boolean add(T value);

    @Intrinsic
    mut boolean remove(&T value);

    @Intrinsic
    boolean contains(&T value);

    @Intrinsic
    mut void clear();

    /**
     * Returns an iterator over the elements of this set, in no particular
     * order.
     *
     * @return an iterator that borrows this set
     */
    Iterator<T> iterator() {
        return new Values<>(this);
    }

    /**
     * Returns a string representation of this set.
     *
     * <p>The elements are shown separated by commas and enclosed in brackets,
     * such as {@code [a, b]}.
     *
     * @return a string representation of this set
     */
    String toString() {
        StringBuilder text = new StringBuilder();
        text.append("[");
        boolean first = true;
        for (&T value : this) {
            if (!first) {
                text.append(", ");
            }
            first = false;
            text.append("" + value);
        }
        text.append("]");
        return text.toString();
    }

    @Intrinsic
    private int slotCount();

    @Intrinsic
    private (&T)? slotAt(int index);

    private static final class Values<T extends Hashable<T>> borrows src implements Iterator<T> {
        private final &HashSet<T> set;
        private int next;

        Values(&HashSet<T> set) keeps set {
            this.set = set;
            this.next = 0;
        }

        boolean hasNext() {
            int index = this.next;
            int count = this.set.slotCount();
            while (index < count && this.set.slotAt(index) == null) {
                index++;
            }
            return index < count;
        }

        mut &T next() borrows src {
            int count = this.set.slotCount();
            while (this.next < count) {
                int index = this.next;
                this.next = index + 1;
                (&T)? slot = this.set.slotAt(index);
                if (slot != null) {
                    return slot;
                }
            }
            throw new IllegalStateException("the iterator has no more elements");
        }
    }
}
