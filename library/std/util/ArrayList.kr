package std.util;

/**
 * A resizable-array implementation of {@link List}.
 *
 * <p>{@link #get}, {@link #set} and adding at the end run in constant
 * time (amortized, for adding). Inserting or removing at any other position
 * takes time proportional to the number of elements after it, which must be
 * shifted.
 *
 * <pre>{@code
 * List<int> squares = new ArrayList<>();
 * for (int i = 1; i <= 4; i++) {
 *     squares.add(i * i);
 * }
 * Console.println(squares); // [1, 4, 9, 16]
 * }</pre>
 *
 * @param <T> the type of the elements
 */
class ArrayList<T> implements List<T> {
    /** Constructs an empty list. */
    ArrayList() {}

    @Intrinsic
    int size();

    @Intrinsic
    &T get(int index);

    @Intrinsic
    mut &mut T getMut(int index);

    @Intrinsic
    mut T set(int index, T value);

    @Intrinsic
    mut void add(T value);

    @Intrinsic
    mut void add(int index, T value);

    @Intrinsic
    mut T remove(int index);

    @Intrinsic
    mut void swap(int a, int b);

    @Intrinsic
    int indexOf(&T value) where T extends Equatable<T>;

    @Intrinsic
    mut void clear();

    /**
     * Returns an iterator over the elements of this list, in order.
     *
     * @return an iterator that borrows this list
     */
    Iterator<T> iterator() {
        return new Values<>(this);
    }

    /**
     * Returns a string representation of this list.
     *
     * <p>The elements are shown in order, separated by commas and enclosed in
     * brackets, such as {@code [1, 2, 3]}.
     *
     * @return a string representation of this list
     */
    String toString() {
        StringBuilder text = new StringBuilder();
        text.append("[");
        for (int i = 0; i < this.size(); i++) {
            if (i > 0) {
                text.append(", ");
            }
            text.append("" + this.get(i));
        }
        text.append("]");
        return text.toString();
    }

    private static final class Values<T> borrows src implements Iterator<T> {
        private final &ArrayList<T> list;
        private int next;

        Values(&ArrayList<T> list) keeps list {
            this.list = list;
            this.next = 0;
        }

        boolean hasNext() {
            return this.next < this.list.size();
        }

        mut &T next() borrows src {
            int index = this.next;
            if (index >= this.list.size()) {
                throw new IllegalStateException("the iterator has no more elements");
            }
            this.next = index + 1;
            return this.list.get(index);
        }
    }
}
