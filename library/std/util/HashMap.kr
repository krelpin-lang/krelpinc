package std.util;

/**
 * A hash table implementation of {@link Map}.
 *
 * <p>{@link #get}, {@link #put}, {@link #remove} and {@link #containsKey}
 * run in constant time on average. The iteration order of the entries is
 * unspecified and may change as entries are added or removed.
 *
 * <pre>{@code
 * Map<String, int> counts = new HashMap<>();
 * for (String word : text.split(" ")) {
 *     (&int)? seen = counts.get(&word);
 *     counts.put(word, seen == null ? 1 : seen + 1);
 * }
 * }</pre>
 *
 * @param <K> the type of the keys, which must be {@link Hashable}
 * @param <V> the type of the values
 */
class HashMap<K extends Hashable<K>, V> implements Map<K, V> {
    /** Constructs an empty map. */
    HashMap() {}

    @Intrinsic
    @Override
    int size();

    @Intrinsic
    @Override
    (&V)? get(&K key) borrows this;

    @Intrinsic
    @Override
    mut (&mut V)? getMut(&K key) borrows this;

    @Intrinsic
    @Override
    mut V? put(K key, V value);

    @Intrinsic
    @Override
    mut V? remove(&K key);

    @Intrinsic
    @Override
    boolean containsKey(&K key);

    @Intrinsic
    @Override
    mut void clear();

    @Intrinsic
    @Override
    Set<&K> keySet();

    @Intrinsic
    @Override
    List<&V> values();

    /**
     * Returns a string representation of this map.
     *
     * <p>The entries are shown as {@code key=value}, separated by commas and
     * enclosed in braces, such as {@code {a=1, b=2}}.
     *
     * @return a string representation of this map
     */
    @Override
    String toString() {
        StringBuilder text = new StringBuilder();
        text.append("{");
        boolean first = true;
        for (&K key : this.keySet()) {
            if (!first) {
                text.append(", ");
            }
            first = false;
            text.append(key + "=" + this.get(key));
        }
        text.append("}");
        return text.toString();
    }
}
