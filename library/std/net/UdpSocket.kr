package std.net;

import std.io.IOException;

/**
 * A UDP socket, which sends and receives individual messages without a
 * connection.
 *
 * <p>A message is delivered whole or not at all. UDP does not retransmit
 * lost messages, and messages may arrive out of order.
 *
 * <pre>{@code
 * UdpSocket socket = UdpSocket.bind("127.0.0.1:0");
 * socket.sendText("ping", "127.0.0.1:9000");
 * Datagram reply = socket.receive(1500);
 * Console.println("${reply.sender()} answered ${reply.text()}");
 * }</pre>
 *
 * <p>The socket is closed when it is dropped.
 */
final class UdpSocket {
    private UdpSocket() {}

    /**
     * Creates a socket bound to an address.
     *
     * @param address the address to bind to, in the form {@code host:port};
     *        port 0 lets the system choose any free port
     * @return the socket
     * @throws IOException if the address is malformed or cannot be resolved,
     *         or the port is in use
     */
    static UdpSocket bind(String address) throws IOException {
        UdpSocket socket = new UdpSocket();
        if (!socket.bindRaw(address)) {
            throw new IOException("couldn't bind to `$address`: ${UdpSocket.lastError()}");
        }
        return socket;
    }

    /**
     * Sends bytes as one message.
     *
     * @param data the content of the message
     * @param address the destination, in the form {@code host:port}
     * @throws IOException if the address cannot be resolved, the message is
     *         too large, or sending fails
     */
    mut void send(&byte[] data, String address) throws IOException {
        if (!this.sendRaw(data, address)) {
            throw new IOException("couldn't send to `$address`: ${UdpSocket.lastError()}");
        }
    }

    /**
     * Sends text, encoded as UTF-8, as one message.
     *
     * @param text the content of the message
     * @param address the destination, in the form {@code host:port}
     * @throws IOException if the address cannot be resolved, the message is
     *         too large, or sending fails
     */
    mut void sendText(String text, String address) throws IOException {
        byte[] data = text.bytes();
        this.send(&data, address);
    }

    /**
     * Receives the next message, blocking until one arrives.
     *
     * <p>A message longer than {@code max} bytes is truncated, and the rest of
     * it is discarded.
     *
     * @param max the maximum number of bytes to receive
     * @return the message and its sender
     * @throws IllegalArgumentException if {@code max} is not between 1 and
     *         65536
     * @throws IOException if receiving fails or times out
     */
    mut Datagram receive(int max) throws IOException {
        if (max <= 0 || max > 65536) {
            throw new IllegalArgumentException("receive: `max` must be from 1 to 65536, not $max");
        }
        byte[]? data = this.receiveRaw(max);
        if (data == null) {
            throw new IOException("couldn't receive: ${UdpSocket.lastError()}");
        }
        String? sender = this.lastSenderRaw();
        if (sender == null) {
            throw new IOException("couldn't read the sender: ${UdpSocket.lastError()}");
        }
        return new Datagram(data, SocketAddr.parse(sender));
    }

    /**
     * Sends bytes as one message if the socket can accept it without
     * blocking.
     *
     * <p>This method is meant for a non-blocking socket; a blocking socket
     * waits instead and always returns {@code true}. The address is
     * resolved before sending, which can block for a host name; pass an IP
     * address to avoid that.
     *
     * @param data the content of the message
     * @param address the destination, in the form {@code host:port}
     * @return {@code true} if the message was sent, {@code false} if the
     *         socket was not ready
     * @throws IOException if the address cannot be resolved, the message is
     *         too large, or sending fails
     */
    mut boolean trySend(&byte[] data, String address) throws IOException {
        int status = this.trySendRaw(data, address);
        if (status < 0) {
            throw new IOException("couldn't send to `$address`: ${UdpSocket.lastError()}");
        }
        return status == 1;
    }

    /**
     * Receives the next message if one has arrived, without blocking.
     *
     * <p>This method is meant for a non-blocking socket; a blocking socket
     * waits for a message instead.
     *
     * @param max the maximum number of bytes to receive
     * @return the message and its sender, or {@code null} if no message is
     *         available
     * @throws IllegalArgumentException if {@code max} is not between 1 and
     *         65536
     * @throws IOException if receiving fails
     */
    mut Datagram? tryReceive(int max) throws IOException {
        if (max <= 0 || max > 65536) {
            throw new IllegalArgumentException("tryReceive: `max` must be from 1 to 65536, not $max");
        }
        byte[]? data = this.tryReceiveRaw(max);
        if (data == null) {
            if (UdpSocket.lastFailed()) {
                throw new IOException("couldn't receive: ${UdpSocket.lastError()}");
            }
            return null;
        }
        String? sender = this.lastSenderRaw();
        if (sender == null) {
            throw new IOException("couldn't read the sender: ${UdpSocket.lastError()}");
        }
        return new Datagram(data, SocketAddr.parse(sender));
    }

    /**
     * Returns the local address this socket is bound to.
     *
     * @return the local address
     * @throws IOException if the address cannot be obtained
     */
    SocketAddr localAddr() throws IOException {
        String? address = this.localAddrRaw();
        if (address == null) {
            throw new IOException("couldn't get the local address: ${UdpSocket.lastError()}");
        }
        return SocketAddr.parse(address);
    }

    /**
     * Sets the time {@link #receive} waits for a message before it fails.
     *
     * @param millis the timeout in milliseconds, or 0 to wait indefinitely,
     *        which is the default
     * @throws IOException if {@code millis} is negative or the timeout cannot
     *         be set
     */
    mut void setReadTimeout(long millis) throws IOException {
        if (!this.setTimeoutRaw(millis, false)) {
            throw new IOException("couldn't set the timeout: ${UdpSocket.lastError()}");
        }
    }


    /**
     * Sets whether this socket is in non-blocking mode.
     *
     * <p>A non-blocking socket is meant to be driven by a {@link Poller}. Its
     * blocking methods throw an {@link IOException} instead of waiting when the
     * socket is not ready.
     *
     * @param nonBlocking {@code true} to enable non-blocking mode, or
     *        {@code false} to restore blocking mode
     * @throws IOException if the mode cannot be changed
     */
    mut void setNonBlocking(boolean nonBlocking) throws IOException {
        if (!this.setNonBlockingRaw(nonBlocking)) {
            throw new IOException("couldn't change the blocking mode: ${UdpSocket.lastError()}");
        }
    }

    /**
     * Registers this socket with a poller.
     *
     * @param poller the poller that reports the socket
     * @param token the token that identifies the socket in the poller's
     *        {@link Event}s
     * @param interest the readiness to report
     * @throws IOException if the registration fails; on Linux this includes a
     *         socket that is already registered with {@code poller}, which
     *         {@link #reregister} must be used for
     */
    void register(&mut Poller poller, int token, Interest interest) throws IOException {
        if (!this.registerRaw(poller, token, interest.readable(), interest.writable(), false)) {
            throw new IOException("couldn't register with the poller: ${UdpSocket.lastError()}");
        }
    }

    /**
     * Changes the token and interest of this socket in a poller it is
     * registered with.
     *
     * @param poller the poller the socket is registered with
     * @param token the new token
     * @param interest the new readiness to report
     * @throws IOException if the registration fails; on Linux this includes a
     *         socket that is not registered with {@code poller}
     */
    void reregister(&mut Poller poller, int token, Interest interest) throws IOException {
        if (!this.registerRaw(poller, token, interest.readable(), interest.writable(), true)) {
            throw new IOException("couldn't register with the poller: ${UdpSocket.lastError()}");
        }
    }

    /**
     * Removes this socket from a poller. Dropping the socket has the same
     * effect.
     *
     * @param poller the poller the socket is registered with
     * @throws IOException if the socket is not registered with {@code poller}
     */
    void deregister(&mut Poller poller) throws IOException {
        if (!this.deregisterRaw(poller)) {
            throw new IOException("couldn't deregister from the poller: ${UdpSocket.lastError()}");
        }
    }

    @Intrinsic
    private mut boolean setNonBlockingRaw(boolean nonBlocking);

    @Intrinsic
    private boolean registerRaw(&mut Poller poller, int token, boolean readable, boolean writable, boolean again);

    @Intrinsic
    private boolean deregisterRaw(&mut Poller poller);

    @Intrinsic
    private mut boolean bindRaw(String address);

    @Intrinsic
    private mut boolean sendRaw(&byte[] data, String address);

    @Intrinsic
    private mut byte[]? receiveRaw(int max);

    @Intrinsic
    private mut int trySendRaw(&byte[] data, String address);

    @Intrinsic
    private mut byte[]? tryReceiveRaw(int max);

    @Intrinsic
    private mut String? lastSenderRaw();

    @Intrinsic
    private String? localAddrRaw();

    @Intrinsic
    private mut boolean setTimeoutRaw(long millis, boolean writing);

    @Intrinsic
    private static String lastError();

    @Intrinsic
    private static boolean lastFailed();
}
