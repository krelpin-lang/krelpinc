package std.net;

enum Interest {
    READABLE,
    WRITABLE,
    READ_WRITE;

    boolean readable() {
        return switch (this) {
            case READABLE, READ_WRITE -> true;
            case WRITABLE -> false;
        };
    }

    boolean writable() {
        return switch (this) {
            case WRITABLE, READ_WRITE -> true;
            case READABLE -> false;
        };
    }

    Interest or(Interest other) {
        return Interest.of(this.readable() || other.readable(), this.writable() || other.writable());
    }

    static Interest of(boolean readable, boolean writable) {
        if (readable && writable) {
            return Interest.READ_WRITE;
        }
        if (readable) {
            return Interest.READABLE;
        }
        if (writable) {
            return Interest.WRITABLE;
        }
        throw new IllegalArgumentException("an interest must include reading, writing or both");
    }
}
