package std.net;

import std.io.IOException;

/**
 * A TCP socket server, which listens for incoming connections.
 *
 * <p>Each call to {@link #accept} blocks until a client connects and returns
 * the connection as a {@link TcpStream}. To serve several clients at once,
 * handle each connection on its own {@link Thread}, or put the listener in
 * non-blocking mode and wait for clients with a {@link Poller}.
 *
 * <pre>{@code
 * TcpListener listener = TcpListener.bind("127.0.0.1:8080");
 * while (true) {
 *     TcpStream client = listener.accept();
 *     String? line = client.readLine();
 *     if (line != null) {
 *         client.write("you said: $line\n");
 *     }
 * }
 * }</pre>
 *
 * <p>The socket is closed when the listener is dropped.
 */
final class TcpListener {
    private TcpListener() {}

    /**
     * Creates a listener bound to an address.
     *
     * <p>Port 0 lets the system choose any free port, which
     * {@link #localAddr} then reports. {@code 0.0.0.0} listens on every IPv4
     * interface and {@code [::]} on every IPv6 interface. The listener sets
     * {@code SO_REUSEADDR}, so a restarted server can bind its port again
     * immediately.
     *
     * <pre>{@code
     * TcpListener listener = TcpListener.bind("0.0.0.0:0");
     * Console.println("listening on ${listener.localAddr()}");
     * }</pre>
     *
     * @param address the address to bind to, in the form {@code host:port}
     * @return the listener
     * @throws IOException if the address is malformed or cannot be resolved,
     *         or the port is in use or requires privileges
     */
    static TcpListener bind(String address) throws IOException {
        TcpListener listener = new TcpListener();
        if (!listener.bindRaw(address)) {
            throw new IOException("couldn't bind to `$address`: ${TcpListener.lastError()}");
        }
        return listener;
    }

    /**
     * Waits for a client to connect and accepts the connection.
     *
     * @return the connection to the client
     * @throws IOException if accepting fails, or the timeout set with
     *         {@link #setAcceptTimeout} expires first
     */
    mut TcpStream accept() throws IOException {
        return TcpStream.accept(this);
    }

    /**
     * Accepts a connection if a client is waiting, without blocking.
     *
     * <p>This method is meant for a non-blocking listener that a
     * {@link Poller} has reported readable; on a blocking listener it waits for
     * a client instead. The returned connection is in non-blocking mode, ready
     * to be registered with a poller.
     *
     * @return the connection to the client, or {@code null} if no client is
     *         waiting
     * @throws IOException if accepting fails, for example because the process
     *         has no free descriptors
     */
    mut TcpStream? tryAccept() throws IOException {
        return TcpStream.tryAccept(this);
    }

    /**
     * Returns the local address this listener is bound to.
     *
     * @return the local address
     * @throws IOException if the address cannot be obtained
     */
    SocketAddr localAddr() throws IOException {
        String? address = this.localAddrRaw();
        if (address == null) {
            throw new IOException("couldn't get the local address: ${TcpListener.lastError()}");
        }
        return SocketAddr.parse(address);
    }

    /**
     * Sets the time {@link #accept} waits for a client before it fails.
     *
     * @param millis the timeout in milliseconds, or 0 to wait indefinitely,
     *        which is the default
     * @throws IOException if {@code millis} is negative or the timeout cannot
     *         be set
     */
    mut void setAcceptTimeout(long millis) throws IOException {
        if (!this.setTimeoutRaw(millis, false)) {
            throw new IOException("couldn't set the timeout: ${TcpListener.lastError()}");
        }
    }


    /**
     * Sets whether this listener is in non-blocking mode.
     *
     * <p>A non-blocking listener is meant to be driven by a {@link Poller}. Its
     * blocking methods throw an {@link IOException} instead of waiting when the
     * listener is not ready.
     *
     * @param nonBlocking {@code true} to enable non-blocking mode, or
     *        {@code false} to restore blocking mode
     * @throws IOException if the mode cannot be changed
     */
    mut void setNonBlocking(boolean nonBlocking) throws IOException {
        if (!this.setNonBlockingRaw(nonBlocking)) {
            throw new IOException("couldn't change the blocking mode: ${TcpListener.lastError()}");
        }
    }

    /**
     * Registers this listener with a poller.
     *
     * @param poller the poller that reports the listener
     * @param token the token that identifies the listener in the poller's
     *        {@link Event}s
     * @param interest the readiness to report
     * @throws IOException if the registration fails; on Linux this includes a
     *         listener that is already registered with {@code poller}, which
     *         {@link #reregister} must be used for
     */
    void register(&mut Poller poller, int token, Interest interest) throws IOException {
        if (!this.registerRaw(poller, token, interest.readable(), interest.writable(), false)) {
            throw new IOException("couldn't register with the poller: ${TcpListener.lastError()}");
        }
    }

    /**
     * Changes the token and interest of this listener in a poller it is
     * registered with.
     *
     * @param poller the poller the listener is registered with
     * @param token the new token
     * @param interest the new readiness to report
     * @throws IOException if the registration fails; on Linux this includes a
     *         listener that is not registered with {@code poller}
     */
    void reregister(&mut Poller poller, int token, Interest interest) throws IOException {
        if (!this.registerRaw(poller, token, interest.readable(), interest.writable(), true)) {
            throw new IOException("couldn't register with the poller: ${TcpListener.lastError()}");
        }
    }

    /**
     * Removes this listener from a poller. Dropping the listener has the same
     * effect.
     *
     * @param poller the poller the listener is registered with
     * @throws IOException if the listener is not registered with {@code poller}
     */
    void deregister(&mut Poller poller) throws IOException {
        if (!this.deregisterRaw(poller)) {
            throw new IOException("couldn't deregister from the poller: ${TcpListener.lastError()}");
        }
    }

    @Intrinsic
    private mut boolean setNonBlockingRaw(boolean nonBlocking);

    @Intrinsic
    private boolean registerRaw(&mut Poller poller, int token, boolean readable, boolean writable, boolean again);

    @Intrinsic
    private boolean deregisterRaw(&mut Poller poller);

    @Intrinsic
    private mut boolean bindRaw(String address);

    @Intrinsic
    private String? localAddrRaw();

    @Intrinsic
    private mut boolean setTimeoutRaw(long millis, boolean writing);

    @Intrinsic
    private static String lastError();
}
