package std.net;

import std.io.IOException;
import std.net.Poller.Interest;

/**
 * A TCP connection between a local and a remote socket, created with
 * {@link #connect} or returned by {@link TcpListener#accept}.
 *
 * <p>Reads block until data arrives, and writes block until the data has
 * been handed to the system. Text is encoded as UTF-8; use {@link #read}
 * and {@link #writeBytes} for binary data.
 *
 * <pre>{@code
 * TcpStream stream = TcpStream.connect("example.com:80");
 * stream.write("GET / HTTP/1.0\r\nHost: example.com\r\n\r\n");
 * String? status = stream.readLine(); // "HTTP/1.0 200 OK"
 * }</pre>
 *
 * <p>The connection is closed when the stream is dropped. Writing to a
 * connection that the peer has closed throws an {@link IOException}; it
 * never terminates the program with {@code SIGPIPE}.
 *
 * <h2>Non-blocking use</h2>
 *
 * <p>A stream created with {@link #startConnect} or
 * {@link TcpListener#tryAccept}, or put in non-blocking mode with
 * {@link #setNonBlocking}, never waits. Register it with a {@link Poller}
 * and call the {@code try} methods when the poller reports it ready:
 * {@link #tryRead}, {@link #tryReadLine} and {@link #tryWrite} return
 * immediately and indicate that the stream is not ready instead of
 * throwing. Outgoing data can also be queued with {@link #queue} and sent
 * with {@link #flush} as the stream becomes writable.
 */
final class TcpStream {
    private TcpStream() {}

    /**
     * Opens a connection to a remote address.
     *
     * <p>A host name is resolved, and each of its addresses is tried in turn.
     *
     * @param address the address to connect to, in the form {@code host:port}
     * @return the connected stream
     * @throws IOException if the address is malformed or cannot be resolved,
     *         or no address accepts the connection
     */
    static TcpStream connect(String address) throws IOException {
        TcpStream stream = new TcpStream();
        if (!stream.connectRaw(address)) {
            throw new IOException("couldn't connect to `$address`: ${TcpStream.lastError()}");
        }
        return stream;
    }

    /**
     * Waits for a client of a listener and accepts the connection. This is
     * equivalent to {@code listener.accept()}.
     *
     * @param listener the listener to accept from
     * @return the connection to the client
     * @throws IOException if accepting fails or times out
     */
    static TcpStream accept(&mut TcpListener listener) throws IOException {
        TcpStream stream = new TcpStream();
        if (!stream.acceptRaw(listener)) {
            throw new IOException("couldn't accept a connection: ${TcpStream.lastError()}");
        }
        return stream;
    }

    /**
     * Starts connecting to a remote address without waiting for the connection
     * to be established.
     *
     * <p>The returned stream is in non-blocking mode. Register it with a
     * {@link Poller} for {@code Interest.WRITABLE}, and call
     * {@link #finishConnect} once the poller reports it.
     *
     * <p>Only the first address that a host name resolves to is tried, and the
     * name is resolved before this method returns, which can block. Pass an IP
     * address to avoid that.
     *
     * <pre>{@code
     * TcpStream stream = TcpStream.startConnect("127.0.0.1:8080");
     * stream.register(&mut poller, 1, Interest.WRITABLE);
     * // ... once the poller reports token 1:
     * if (stream.finishConnect()) {
     *     stream.reregister(&mut poller, 1, Interest.READABLE);
     * }
     * }</pre>
     *
     * @param address the address to connect to, in the form {@code host:port}
     * @return a non-blocking stream whose connection is in progress
     * @throws IOException if the address is malformed or cannot be resolved,
     *         or the connection fails immediately
     */
    static TcpStream startConnect(String address) throws IOException {
        TcpStream stream = new TcpStream();
        if (!stream.startConnectRaw(address)) {
            throw new IOException("couldn't connect to `$address`: ${TcpStream.lastError()}");
        }
        return stream;
    }

    /**
     * Completes a connection started with {@link #startConnect}.
     *
     * @return {@code true} if the connection is established, {@code false} if
     *         it is still in progress
     * @throws IOException if the connection failed, for example because it was
     *         refused
     */
    mut boolean finishConnect() throws IOException {
        int status = this.finishConnectRaw();
        if (status < 0) {
            throw new IOException("couldn't connect: ${TcpStream.lastError()}");
        }
        return status == 1;
    }

    /**
     * Accepts a connection from a listener if a client is waiting. This is
     * equivalent to {@code listener.tryAccept()}.
     *
     * @param listener the listener to accept from
     * @return the connection to the client, or {@code null} if no client is
     *         waiting
     * @throws IOException if accepting fails
     */
    static TcpStream? tryAccept(&mut TcpListener listener) throws IOException {
        TcpStream stream = new TcpStream();
        int status = stream.tryAcceptRaw(listener);
        if (status < 0) {
            throw new IOException("couldn't accept a connection: ${TcpStream.lastError()}");
        }
        return status == 1 ? stream : null;
    }

    /**
     * Reads the next line, blocking until it has arrived.
     *
     * <p>A final line without a line terminator is still returned. Bytes
     * received after the line are kept for the next call to {@code readLine},
     * {@link #read} or {@link #readAll}.
     *
     * @return the line without its {@code \n} or {@code \r\n} terminator, or
     *         {@code null} if the peer has closed the connection
     * @throws IOException if reading fails or times out, or the line is not
     *         valid UTF-8
     */
    mut String? readLine() throws IOException {
        String? line = this.readLineRaw();
        if (line == null && TcpStream.lastFailed()) {
            throw new IOException("couldn't read a line: ${TcpStream.lastError()}");
        }
        return line;
    }

    /**
     * Reads until the peer closes the connection.
     *
     * @return all text received
     * @throws IOException if reading fails or times out, or the text is not
     *         valid UTF-8
     */
    mut String readAll() throws IOException {
        String? text = this.readAllRaw();
        if (text == null) {
            throw new IOException("couldn't read the connection: ${TcpStream.lastError()}");
        }
        return text;
    }

    /**
     * Reads bytes, blocking until data is available.
     *
     * @param max the maximum number of bytes to read
     * @return the bytes read, or an empty array if the peer has closed the
     *         connection
     * @throws IllegalArgumentException if {@code max} is not positive
     * @throws IOException if reading fails or times out
     */
    mut byte[] read(int max) throws IOException {
        if (max <= 0) {
            throw new IllegalArgumentException("read: `max` must be positive, not $max");
        }
        byte[]? bytes = this.readRaw(max);
        if (bytes == null) {
            throw new IOException("couldn't read the connection: ${TcpStream.lastError()}");
        }
        return bytes;
    }

    /**
     * Reads the next line if a complete line has arrived, without blocking.
     *
     * <p>The bytes of an incomplete line are kept, so call this method again
     * when the stream becomes readable. After the peer has closed the
     * connection, a final line without a terminator is returned, and then
     * {@code null} with {@link #atEnd} returning {@code true}.
     *
     * <pre>{@code
     * String? line = stream.tryReadLine();
     * while (line != null) {
     *     handle(line);
     *     line = stream.tryReadLine();
     * }
     * if (stream.atEnd()) {
     *     // the client has gone
     * }
     * }</pre>
     *
     * @return the line without its terminator, or {@code null} if no complete
     *         line is available
     * @throws IOException if reading fails, or the line is not valid UTF-8
     */
    mut String? tryReadLine() throws IOException {
        String? line = this.tryReadLineRaw();
        if (line == null && TcpStream.lastFailed()) {
            throw new IOException("couldn't read a line: ${TcpStream.lastError()}");
        }
        return line;
    }

    /**
     * Returns whether the end of the stream has been reached.
     *
     * @return {@code true} if the peer has closed the connection and every byte
     *         it sent has been read
     */
    boolean atEnd() {
        return this.atEndRaw();
    }

    /**
     * Reads the bytes that have arrived, without blocking.
     *
     * @param max the maximum number of bytes to read
     * @return the bytes read; an empty array if the peer has closed the
     *         connection, or {@code null} if no data is available yet
     * @throws IllegalArgumentException if {@code max} is not positive
     * @throws IOException if reading fails
     */
    mut byte[]? tryRead(int max) throws IOException {
        if (max <= 0) {
            throw new IllegalArgumentException("tryRead: `max` must be positive, not $max");
        }
        byte[]? bytes = this.tryReadRaw(max);
        if (bytes == null && TcpStream.lastFailed()) {
            throw new IOException("couldn't read the connection: ${TcpStream.lastError()}");
        }
        return bytes;
    }

    /**
     * Writes as much of an array as the stream accepts without blocking.
     *
     * <pre>{@code
     * int sent = 0;
     * // each time the poller reports the stream writable:
     * sent += stream.tryWrite(&data, sent);
     * if (sent == data.length) {
     *     // done
     * }
     * }</pre>
     *
     * @param bytes the bytes to write
     * @param offset the index of the first byte to write
     * @return the number of bytes written, or 0 if the send buffer is full
     * @throws IndexOutOfBoundsException if {@code offset} is negative or
     *         greater than {@code bytes.length}
     * @throws IOException if writing fails or the peer has closed the
     *         connection
     */
    mut int tryWrite(&byte[] bytes, int offset) throws IOException {
        if (offset < 0 || offset > bytes.length) {
            throw new IndexOutOfBoundsException(
                "tryWrite: offset $offset is outside 0..${bytes.length}"
            );
        }
        int sent = this.tryWriteRaw(bytes, offset);
        if (sent < 0) {
            throw new IOException("couldn't write to the connection: ${TcpStream.lastError()}");
        }
        return sent;
    }

    /**
     * Appends text, encoded as UTF-8, to the bytes waiting to be sent,
     * without sending anything. {@link #flush} sends the queued bytes.
     *
     * @param text the text to queue
     */
    mut void queue(String text) {
        this.queueRaw(text);
    }

    /**
     * Appends bytes to the bytes waiting to be sent, as {@link #queue} does.
     *
     * @param bytes the bytes to queue
     */
    mut void queueBytes(&byte[] bytes) {
        this.queueBytesRaw(bytes);
    }

    /**
     * Sends as many queued bytes as the stream accepts without blocking.
     *
     * <p>If this method returns {@code false}, wait for the stream to become
     * writable and call it again.
     *
     * <pre>{@code
     * stream.queue("hello\n");
     * if (!stream.flush()) {
     *     stream.reregister(&mut poller, token, Interest.READ_WRITE);
     * }
     * }</pre>
     *
     * @return {@code true} if every queued byte has been sent
     * @throws IOException if writing fails or the peer has closed the
     *         connection
     */
    mut boolean flush() throws IOException {
        int status = this.flushRaw();
        if (status < 0) {
            throw new IOException("couldn't write to the connection: ${TcpStream.lastError()}");
        }
        return status == 1;
    }

    /**
     * Returns the number of queued bytes that have not been sent yet.
     *
     * @return the number of bytes waiting for {@link #flush}
     */
    long queued() {
        return this.queuedRaw();
    }

    /**
     * Writes text, encoded as UTF-8, blocking until all of it has been sent.
     *
     * @param text the text to write
     * @throws IOException if writing fails or times out, or the peer has
     *         closed the connection
     */
    mut void write(String text) throws IOException {
        if (!this.writeRaw(text)) {
            throw new IOException("couldn't write to the connection: ${TcpStream.lastError()}");
        }
    }

    /**
     * Writes bytes, blocking until all of them have been sent.
     *
     * @param bytes the bytes to write
     * @throws IOException if writing fails or times out, or the peer has
     *         closed the connection
     */
    mut void writeBytes(&byte[] bytes) throws IOException {
        if (!this.writeBytesRaw(bytes)) {
            throw new IOException("couldn't write to the connection: ${TcpStream.lastError()}");
        }
    }

    /**
     * Shuts down the writing side of the connection, while still allowing
     * reads.
     *
     * <p>The peer's reads then reach the end of the stream, which is how a
     * client signals that it has sent its complete request.
     *
     * <pre>{@code
     * stream.write(request);
     * stream.shutdownWrite();
     * String response = stream.readAll();
     * }</pre>
     *
     * @throws IOException if the connection cannot be shut down
     */
    mut void shutdownWrite() throws IOException {
        if (!this.shutdownWriteRaw()) {
            throw new IOException("couldn't shut the connection down: ${TcpStream.lastError()}");
        }
    }

    /**
     * Returns the address of the remote end of this connection.
     *
     * @return the peer address
     * @throws IOException if the address cannot be obtained
     */
    SocketAddr peerAddr() throws IOException {
        String? address = this.peerAddrRaw();
        if (address == null) {
            throw new IOException("couldn't get the peer address: ${TcpStream.lastError()}");
        }
        return SocketAddr.parse(address);
    }

    /**
     * Returns the address of the local end of this connection.
     *
     * @return the local address
     * @throws IOException if the address cannot be obtained
     */
    SocketAddr localAddr() throws IOException {
        String? address = this.localAddrRaw();
        if (address == null) {
            throw new IOException("couldn't get the local address: ${TcpStream.lastError()}");
        }
        return SocketAddr.parse(address);
    }

    /**
     * Sets the time a read waits for data before it fails.
     *
     * @param millis the timeout in milliseconds, or 0 to wait indefinitely,
     *        which is the default
     * @throws IOException if {@code millis} is negative or the timeout cannot
     *         be set
     */
    mut void setReadTimeout(long millis) throws IOException {
        if (!this.setTimeoutRaw(millis, false)) {
            throw new IOException("couldn't set the timeout: ${TcpStream.lastError()}");
        }
    }

    /**
     * Sets the time a write waits for progress before it fails.
     *
     * @param millis the timeout in milliseconds, or 0 to wait indefinitely,
     *        which is the default
     * @throws IOException if {@code millis} is negative or the timeout cannot
     *         be set
     */
    mut void setWriteTimeout(long millis) throws IOException {
        if (!this.setTimeoutRaw(millis, true)) {
            throw new IOException("couldn't set the timeout: ${TcpStream.lastError()}");
        }
    }

    /**
     * Enables or disables {@code TCP_NODELAY}, which turns off Nagle's
     * algorithm.
     *
     * <p>With the option enabled, small writes are sent immediately instead of
     * being coalesced, which lowers the latency of request-response protocols.
     *
     * @param noDelay {@code true} to send small writes immediately
     * @throws IOException if the option cannot be set
     */
    mut void setNoDelay(boolean noDelay) throws IOException {
        if (!this.setNoDelayRaw(noDelay)) {
            throw new IOException("couldn't set TCP_NODELAY: ${TcpStream.lastError()}");
        }
    }


    /**
     * Sets whether this stream is in non-blocking mode.
     *
     * <p>A non-blocking stream is meant to be driven by a {@link Poller}. Its
     * blocking methods throw an {@link IOException} instead of waiting when the
     * stream is not ready.
     *
     * @param nonBlocking {@code true} to enable non-blocking mode, or
     *        {@code false} to restore blocking mode
     * @throws IOException if the mode cannot be changed
     */
    mut void setNonBlocking(boolean nonBlocking) throws IOException {
        if (!this.setNonBlockingRaw(nonBlocking)) {
            throw new IOException("couldn't change the blocking mode: ${TcpStream.lastError()}");
        }
    }

    /**
     * Registers this stream with a poller.
     *
     * @param poller the poller that reports the stream
     * @param token the token that identifies the stream in the poller's
     *        {@link Poller.Event}s
     * @param interest the readiness to report
     * @throws IOException if the registration fails; on Linux this includes a
     *         stream that is already registered with {@code poller}, which
     *         {@link #reregister} must be used for
     */
    void register(&mut Poller poller, int token, Interest interest) throws IOException {
        if (!this.registerRaw(poller, token, interest.readable(), interest.writable(), false)) {
            throw new IOException("couldn't register with the poller: ${TcpStream.lastError()}");
        }
    }

    /**
     * Changes the token and interest of this stream in a poller it is
     * registered with.
     *
     * @param poller the poller the stream is registered with
     * @param token the new token
     * @param interest the new readiness to report
     * @throws IOException if the registration fails; on Linux this includes a
     *         stream that is not registered with {@code poller}
     */
    void reregister(&mut Poller poller, int token, Interest interest) throws IOException {
        if (!this.registerRaw(poller, token, interest.readable(), interest.writable(), true)) {
            throw new IOException("couldn't register with the poller: ${TcpStream.lastError()}");
        }
    }

    /**
     * Removes this stream from a poller. Dropping the stream has the same
     * effect.
     *
     * @param poller the poller the stream is registered with
     * @throws IOException if the stream is not registered with {@code poller}
     */
    void deregister(&mut Poller poller) throws IOException {
        if (!this.deregisterRaw(poller)) {
            throw new IOException("couldn't deregister from the poller: ${TcpStream.lastError()}");
        }
    }

    @Intrinsic
    private mut boolean setNonBlockingRaw(boolean nonBlocking);

    @Intrinsic
    private boolean registerRaw(&mut Poller poller, int token, boolean readable, boolean writable, boolean again);

    @Intrinsic
    private boolean deregisterRaw(&mut Poller poller);

    @Intrinsic
    private mut boolean connectRaw(String address);

    @Intrinsic
    private mut boolean startConnectRaw(String address);

    @Intrinsic
    private mut int finishConnectRaw();

    @Intrinsic
    private mut int tryAcceptRaw(&mut TcpListener listener);

    @Intrinsic
    private mut String? tryReadLineRaw();

    @Intrinsic
    private boolean atEndRaw();

    @Intrinsic
    private mut byte[]? tryReadRaw(int max);

    @Intrinsic
    private mut int tryWriteRaw(&byte[] bytes, int offset);

    @Intrinsic
    private mut void queueRaw(String text);

    @Intrinsic
    private mut void queueBytesRaw(&byte[] bytes);

    @Intrinsic
    private mut int flushRaw();

    @Intrinsic
    private long queuedRaw();

    @Intrinsic
    private mut boolean acceptRaw(&mut TcpListener listener);

    @Intrinsic
    private mut String? readLineRaw();

    @Intrinsic
    private mut String? readAllRaw();

    @Intrinsic
    private mut byte[]? readRaw(int max);

    @Intrinsic
    private mut boolean writeRaw(String text);

    @Intrinsic
    private mut boolean writeBytesRaw(&byte[] bytes);

    @Intrinsic
    private mut boolean shutdownWriteRaw();

    @Intrinsic
    private String? peerAddrRaw();

    @Intrinsic
    private String? localAddrRaw();

    @Intrinsic
    private mut boolean setTimeoutRaw(long millis, boolean writing);

    @Intrinsic
    private mut boolean setNoDelayRaw(boolean noDelay);

    @Intrinsic
    private static String lastError();

    @Intrinsic
    private static boolean lastFailed();
}
