package std.macros;

import std.primitive.Int;
import std.util.ArrayList;
import std.util.List;

/**
 * The connection between a macro crate and the compiler that runs it.
 *
 * <p>The compiler generates the {@code main} method of every macro crate
 * around this class, so macros never use it directly. Requests and replies
 * are exchanged as lines of tab-separated text.
 */
final class Bridge {
    private final List<String> macros;
    private String current;

    Bridge() {
        this.macros = new ArrayList<>();
        this.current = "";
    }

    /**
     * Declares a macro that this crate provides.
     *
     * @param name the name of the macro
     */
    mut void declare(String name) {
        this.macros.add(name);
    }

    /**
     * Tells the compiler that this crate is ready, and which macros it
     * provides.
     *
     * @param crateName the name of the macro crate
     */
    mut void ready(String crateName) {
        open();
        String line = "krelpin-macro-server\t1\t" + escape(crateName);
        for (&String name : this.macros) {
            line = line + "\t" + escape(name);
        }
        send(line);
    }

    /**
     * Waits for the next request from the compiler.
     *
     * @return {@code true} if a request was received, or {@code false} if the
     *         compiler has no more requests
     * @throws IllegalStateException if the request is malformed
     */
    mut boolean next() {
        String? line = receive();
        if (line == null) {
            return false;
        }
        String[] parts = line.split("\t");
        if (parts.length != 2 || !parts[0].equals(&"expand")) {
            throw new IllegalStateException("the compiler sent a malformed macro request");
        }
        this.current = unescape(parts[1]);
        return true;
    }

    /**
     * Returns whether the current request is for a macro.
     *
     * @param name the name of the macro
     * @return {@code true} if the compiler requested {@code name}
     */
    boolean calls(String name) {
        return this.current.equals(&name);
    }

    /**
     * Reads a token stream sent with the current request.
     *
     * @return the token stream
     */
    TokenStream read() {
        return readStream();
    }

    /**
     * Sends the tokens that a macro returned to the compiler.
     *
     * @param output the tokens produced by the macro
     */
    void reply(TokenStream output) {
        send("ok\t" + output.size());
        for (int i = 0; i < output.size(); i++) {
            Token token = output.get(i);
            send(kindName(token.kind()) + "\t" + token.span().id() + "\t" + escape(token.text()));
        }
    }

    /**
     * Reports an error that a macro threw to the compiler.
     *
     * @param error the error
     */
    void fail(&MacroError error) {
        String message = error.getMessage() ?: "the macro failed";
        send("error\t" + error.span().id() + "\t" + escape(message));
    }

    /** Reports that the requested macro does not exist in this crate. */
    void unknown() {
        send("error\t-1\t" + escape("this crate has no macro `" + this.current + "`"));
    }

    /**
     * Asks the compiler to split source code into tokens.
     *
     * @param source the source code
     * @return the tokens of {@code source}
     */
    static TokenStream lex(String source) {
        send("lex\t" + escape(source));
        return readStream();
    }

    private static TokenStream readStream() {
        String header = receive() ?: "";
        String[] parts = header.split("\t");
        if (parts.length != 2 || !parts[0].equals(&"tokens")) {
            throw new IllegalStateException(
                "token streams can only be parsed while the compiler runs a macro");
        }
        int count = Int.parse(parts[1]);
        TokenStream stream = new TokenStream();
        for (int i = 0; i < count; i++) {
            String line = receive() ?: "";
            String[] fields = line.split("\t");
            if (fields.length != 3) {
                throw new IllegalStateException("the compiler sent a malformed token");
            }
            Token token = new Token(kindOf(fields[0]), unescape(fields[2]),
                new Span(Int.parse(fields[1])));
            stream.add(token);
        }
        return stream;
    }

    private static Token.Kind kindOf(String name) {
        if (name.equals(&"ident")) {
            return Token.Kind.IDENT;
        }
        if (name.equals(&"literal")) {
            return Token.Kind.LITERAL;
        }
        if (name.equals(&"doc")) {
            return Token.Kind.DOC;
        }
        return Token.Kind.PUNCT;
    }

    private static String kindName(Token.Kind kind) {
        return switch (kind) {
            case IDENT -> "ident";
            case LITERAL -> "literal";
            case PUNCT -> "punct";
            case DOC -> "doc";
        };
    }

    @Intrinsic
    private static void open();

    @Intrinsic
    private static String? receive();

    @Intrinsic
    private static void send(String line);

    @Intrinsic
    private static String escape(String text);

    @Intrinsic
    private static String unescape(String text);
}
