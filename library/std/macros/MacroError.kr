package std.macros;

/**
 * An error that a macro reports to the code that uses it.
 *
 * <p>When a macro throws a {@code MacroError}, the compiler stops expanding
 * the macro and reports the message as a compile error, at the token given
 * to the constructor or otherwise at the macro invocation. Any other
 * exception is reported as a crash of the macro.
 *
 * <pre>{@code
 * macro Getters(TokenStream args, TokenStream input) {
 *     Item item = Item.parse(&input);
 *     if (item.kind() == Item.Kind.INTERFACE) {
 *         throw new MacroError("`@Getters` can't go on an interface", &item.name());
 *     }
 *     ...
 * }
 * }</pre>
 */
class MacroError extends RuntimeException {
    private final Span span;

    /**
     * Constructs an error reported at the macro invocation.
     *
     * @param message the error message
     */
    MacroError(String message) {
        super(message);
        this.span = Span.callSite();
    }

    /**
     * Constructs an error reported at a token.
     *
     * @param message the error message
     * @param at the token the error points at
     */
    MacroError(String message, &Token at) {
        super(message);
        this.span = at.span();
    }

    /**
     * Returns the location at which the compiler reports this error.
     *
     * @return the span of the error
     */
    Span span() {
        return this.span;
    }
}
