package std.macros;

/**
 * An annotation, such as {@code @Default(10)}, written on an item or a
 * member.
 *
 * <p>Macros use annotations as options: a {@code @Builder} macro can read
 * the {@code @Default} annotation of each field and then remove it, so that
 * the compiler never sees an annotation it does not recognize.
 *
 * @see Item#attributes
 * @see Member#attributes
 */
final class Attribute {
    private final Token name;
    private final TokenStream tokens;
    private final TokenStream args;

    private Attribute(Token name, TokenStream tokens, TokenStream args) {
        this.name = name;
        this.tokens = tokens;
        this.args = args;
    }

    /**
     * Returns the simple name of this annotation.
     *
     * @return the name token; for {@code @a.b.Name} this is {@code Name}
     */
    Token name() {
        return this.name;
    }

    /**
     * Returns whether this annotation has the specified simple name.
     *
     * @param name the name to test
     * @return {@code true} if the annotation is called {@code name}
     */
    boolean is(String name) {
        return this.name.text().equals(&name);
    }

    /**
     * Returns the arguments of this annotation.
     *
     * @return the tokens between the parentheses, such as {@code 1 + 2} for
     *         {@code @Default(1 + 2)}, or no tokens if the annotation has no
     *         parentheses
     */
    &TokenStream args() {
        return &this.args;
    }

    /**
     * Returns this annotation as it was written.
     *
     * @return a copy of the annotation's tokens
     */
    TokenStream toTokens() {
        return this.tokens.copy();
    }

    /**
     * Finds the end of an annotation. Used by {@link Item#parse} and
     * {@link Member#parse}.
     *
     * @param tokens the tokens to search
     * @param at the index where an annotation may start
     * @return the index just past the annotation, or -1 if no annotation
     *         starts at {@code at}
     * @throws MacroError if the annotation's opening parenthesis is never
     *         closed
     */
    static int end(&TokenStream tokens, int at) {
        if (at + 1 >= tokens.size() || !tokens.get(at).isPunct("@")
                || !tokens.get(at + 1).isIdent() || tokens.get(at + 1).isIdent("interface")) {
            return -1;
        }
        int end = at + 2;
        while (end + 1 < tokens.size() && tokens.get(end).isPunct(".")
                && tokens.get(end + 1).isIdent()) {
            end = end + 2;
        }
        if (end < tokens.size() && tokens.get(end).isPunct("(")) {
            int close = tokens.matching(end);
            if (close < 0) {
                throw new MacroError("this `(` is never closed", &tokens.get(end));
            }
            end = close + 1;
        }
        return end;
    }

    /**
     * Reads an annotation whose bounds were found by {@link #end}.
     *
     * @param tokens the tokens that contain the annotation
     * @param start the index of the {@code @}
     * @param end the index just past the annotation
     * @return the annotation
     */
    static Attribute read(&TokenStream tokens, int start, int end) {
        int nameEnd = start + 2;
        while (nameEnd + 1 < end && tokens.get(nameEnd).isPunct(".")) {
            nameEnd = nameEnd + 2;
        }
        TokenStream args = new TokenStream();
        if (nameEnd < end) {
            args = tokens.slice(nameEnd + 1, end - 1);
        }
        return new Attribute(tokens.get(nameEnd - 1), tokens.slice(start, end), args);
    }
}
