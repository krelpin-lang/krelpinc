package std.macros;

import std.util.ArrayList;
import std.util.List;

/**
 * A member of a type declaration: a field, method, constructor, nested
 * type or initializer block.
 *
 * <pre>{@code
 * for (&Member member : item.members()) {
 *     if (member.isMethod() && member.hasAttribute("Trace")) {
 *         // member.name(), member.params() and member.body() are available here
 *     }
 * }
 * }</pre>
 *
 * @see Item#members
 */
final class Member {
    private final TokenStream docs;
    private final List<Attribute> attributes;
    private TokenStream rest;
    private Kind kind;
    private int modifiersEnd;
    private int typeStart;
    private int nameAt;
    private int open;
    private int close;
    private int bodyOpen;
    private int bodyClose;
    private int initAt;

    private Member(TokenStream docs, List<Attribute> attributes, TokenStream rest) {
        this.docs = docs;
        this.attributes = attributes;
        this.rest = rest;
        this.kind = Kind.FIELD;
        this.modifiersEnd = 0;
        this.typeStart = 0;
        this.nameAt = -1;
        this.open = -1;
        this.close = -1;
        this.bodyOpen = -1;
        this.bodyClose = -1;
        this.initAt = -1;
        this.analyze();
    }

    /**
     * Parses a member, including its doc comments and annotations.
     *
     * @param tokens the tokens of the member
     * @return the parsed member
     * @throws MacroError if {@code tokens} does not contain a member
     */
    static Member parse(&TokenStream tokens) {
        int at = 0;
        TokenStream docs = new TokenStream();
        while (at < tokens.size() && tokens.get(at).isDoc()) {
            docs.add(tokens.get(at));
            at++;
        }
        List<Attribute> attributes = new ArrayList<>();
        int end = Attribute.end(tokens, at);
        while (end >= 0) {
            attributes.add(Attribute.read(tokens, at, end));
            at = end;
            end = Attribute.end(tokens, at);
        }
        if (at >= tokens.size()) {
            throw new MacroError("expected a member");
        }
        return new Member(docs, attributes, tokens.slice(at, tokens.size()));
    }

    /**
     * Returns the kind of this member.
     *
     * @return the kind of member
     */
    Kind kind() {
        return this.kind;
    }

    /**
     * Returns whether this member is an instance field.
     *
     * @return {@code true} for a field that is not {@code static}
     */
    boolean isField() {
        return this.kind == Kind.FIELD && !this.isStatic();
    }

    /**
     * Returns whether this member is a method.
     *
     * @return {@code true} for a method
     */
    boolean isMethod() {
        return this.kind == Kind.METHOD;
    }

    /**
     * Returns the name of this member.
     *
     * @return the name token; for a constructor, the name of the class
     * @throws MacroError if this member is an initializer block, which has no
     *         name
     */
    Token name() {
        if (this.nameAt < 0) {
            throw new MacroError("this member has no name", &this.rest.get(0));
        }
        return this.rest.get(this.nameAt);
    }

    /**
     * Returns whether this member is declared with a modifier.
     *
     * @param modifier the modifier, such as {@code "private"}
     * @return {@code true} if the member has {@code modifier}
     */
    boolean hasModifier(String modifier) {
        for (int i = 0; i < this.modifiersEnd; i++) {
            if (this.rest.get(i).isIdent(modifier)) {
                return true;
            }
        }
        return false;
    }

    /**
     * Returns whether this member is static.
     *
     * @return {@code true} if the member is {@code static}
     */
    boolean isStatic() {
        return this.hasModifier("static");
    }

    /**
     * Returns the type of a field or the return type of a method.
     *
     * @return the type, such as {@code List<String>} for
     *         {@code private List<String> names;}, or no tokens for other
     *         members
     */
    TokenStream type() {
        if (this.kind != Kind.FIELD && this.kind != Kind.METHOD) {
            return new TokenStream();
        }
        return this.rest.slice(this.typeStart, this.nameAt);
    }

    /**
     * Returns the parameters of a method or constructor.
     *
     * @return the tokens between the parentheses, or no tokens for other
     *         members
     */
    TokenStream params() {
        if (this.open < 0) {
            return new TokenStream();
        }
        return this.rest.slice(this.open + 1, this.close);
    }

    /**
     * Returns whether this member has a body in braces.
     *
     * @return {@code true} for a method or constructor with a body, a nested
     *         type or an initializer block
     */
    boolean hasBody() {
        return this.bodyOpen >= 0;
    }

    /**
     * Returns the body of this member.
     *
     * @return the tokens between the braces of the body, or no tokens if the
     *         member has no body
     */
    TokenStream body() {
        if (this.bodyOpen < 0) {
            return new TokenStream();
        }
        return this.rest.slice(this.bodyOpen + 1, this.bodyClose);
    }

    /**
     * Returns the initializer of a field.
     *
     * @return the expression after the {@code =}, or no tokens if the field
     *         has no initializer
     */
    TokenStream initializer() {
        if (this.initAt < 0) {
            return new TokenStream();
        }
        return this.rest.slice(this.initAt, this.rest.size() - 1);
    }

    /**
     * Replaces the body of this member.
     *
     * <pre>{@code
     * TokenStream traced = TokenStream.parse("Console.println(\"enter\");");
     * traced.addAll(&member.body());
     * member.setBody(&traced);
     * }</pre>
     *
     * @param body the tokens to place between the braces
     * @throws MacroError if this member has no body or is a nested type
     */
    mut void setBody(&TokenStream body) {
        if (this.bodyOpen < 0 || this.kind == Kind.TYPE) {
            throw new MacroError("only methods, constructors and initializers have a body",
                &this.rest.get(0));
        }
        TokenStream rest = this.rest.slice(0, this.bodyOpen + 1);
        rest.addAll(body);
        rest.addAll(&this.rest.slice(this.bodyClose, this.rest.size()));
        this.rest = rest;
        this.analyze();
    }

    /**
     * Returns the annotations written on this member.
     *
     * @return the annotations, in source order
     */
    &List<Attribute> attributes() {
        return &this.attributes;
    }

    /**
     * Returns whether this member has an annotation with the specified name.
     *
     * @param name the simple name of the annotation
     * @return {@code true} if such an annotation is present
     */
    boolean hasAttribute(String name) {
        for (&Attribute attribute : this.attributes) {
            if (attribute.is(name)) {
                return true;
            }
        }
        return false;
    }

    /**
     * Returns the arguments of the first annotation with the specified name.
     *
     * @param name the simple name of the annotation
     * @return the arguments, such as {@code 10} for {@code @Default(10)}, or no
     *         tokens if there is no such annotation
     */
    TokenStream attribute(String name) {
        for (&Attribute attribute : this.attributes) {
            if (attribute.is(name)) {
                return attribute.args().copy();
            }
        }
        return new TokenStream();
    }

    /**
     * Removes every annotation with the specified name from this member.
     *
     * @param name the simple name of the annotations to remove
     * @return the number of annotations removed
     */
    mut int removeAttribute(String name) {
        int removed = 0;
        int i = 0;
        while (i < this.attributes.size()) {
            if (this.attributes.get(i).is(name)) {
                this.attributes.remove(i);
                removed++;
            } else {
                i++;
            }
        }
        return removed;
    }

    /**
     * Returns this member as tokens, including any changes made to it.
     *
     * @return the tokens of the member
     */
    TokenStream toTokens() {
        TokenStream out = this.docs.copy();
        for (&Attribute attribute : this.attributes) {
            out.addAll(&attribute.toTokens());
        }
        out.addAll(&this.rest);
        return out;
    }

    private mut void analyze() {
        TokenStream rest = this.rest.copy();
        int at = 0;
        while (at < rest.size() && isModifier(rest.get(at))) {
            at++;
        }
        this.modifiersEnd = at;
        this.typeStart = at;
        this.nameAt = -1;
        this.open = -1;
        this.close = -1;
        this.bodyOpen = -1;
        this.bodyClose = -1;
        this.initAt = -1;
        if (at >= rest.size()) {
            throw new MacroError("expected a member after its modifiers", &rest.get(0));
        }
        Token first = rest.get(at);
        if (first.isIdent("class") || first.isIdent("record") || first.isIdent("interface")
                || first.isIdent("enum")) {
            this.kind = Kind.TYPE;
            this.nameAt = at + 1;
            this.bodyOpen = rest.indexOf("{", at);
            this.bodyClose = this.bodyOpen < 0 ? -1 : rest.matching(this.bodyOpen);
            return;
        }
        if (first.isPunct("{")) {
            this.kind = Kind.INITIALIZER;
            this.bodyOpen = at;
            this.bodyClose = rest.matching(at);
            return;
        }
        if (first.isPunct("<")) {
            int closing = rest.matching(at);
            if (closing < 0) {
                throw new MacroError("this `<` is never closed", &first);
            }
            this.typeStart = closing + 1;
        }
        for (int i = this.typeStart; i < rest.size(); i++) {
            Token token = rest.get(i);
            if (token.isPunct("(")) {
                this.nameAt = i - 1;
                this.open = i;
                this.close = rest.matching(i);
                if (this.close < 0) {
                    throw new MacroError("this `(` is never closed", &token);
                }
                this.kind = this.nameAt == this.typeStart
                    ? Kind.CONSTRUCTOR
                    : Kind.METHOD;
                for (int j = this.close + 1; j < rest.size(); j++) {
                    if (rest.get(j).isPunct("{")) {
                        this.bodyOpen = j;
                        this.bodyClose = rest.matching(j);
                        return;
                    }
                    if (rest.get(j).isPunct(";")) {
                        return;
                    }
                }
                return;
            }
            if (token.isPunct("=")) {
                this.kind = Kind.FIELD;
                this.nameAt = i - 1;
                this.initAt = i + 1;
                return;
            }
            if (token.isPunct(";")) {
                this.kind = Kind.FIELD;
                this.nameAt = i - 1;
                return;
            }
        }
        throw new MacroError("expected a field, method, constructor or type", &first);
    }

    private static boolean isModifier(Token token) {
        return token.isIdent("public") || token.isIdent("protected")
            || token.isIdent("private") || token.isIdent("static")
            || token.isIdent("final") || token.isIdent("abstract") || token.isIdent("mut")
            || token.isIdent("move");
    }

    /** The kind of declaration a {@link Member} holds. */
    enum Kind {
        /** A field, with or without an initializer, or a record component. */
        FIELD,
        /** A method, with or without a body. */
        METHOD,
        /** A constructor. */
        CONSTRUCTOR,
        /** A nested class, record, interface or enum. */
        TYPE,
        /** An initializer block, {@code { ... }}, in a class body. */
        INITIALIZER
    }
}
