package std.macros;

import std.util.ArrayList;
import std.util.Iterator;
import std.util.List;

/**
 * A sequence of tokens: the code a macro receives and the code it returns.
 *
 * <p>A macro receives the tokens of the item it is applied to and returns
 * the tokens that replace it. The tokens can be modified in place, but
 * {@link Item} and {@link Member} are easier to use for anything that
 * depends on the structure of a declaration.
 *
 * <pre>{@code
 * macro Hello(TokenStream args, TokenStream item) {
 *     int close = item.lastIndexOf("}");
 *     item.insertAll(close, &TokenStream.parse("static String hello() { return \"hi\"; }"));
 *     return item;
 * }
 * }</pre>
 */
final class TokenStream implements Iterable<Token> {
    private final List<Token> tokens;

    /** Constructs an empty token stream. */
    TokenStream() {
        this.tokens = new ArrayList<>();
    }

    /**
     * Splits source code into tokens, as the compiler does.
     *
     * <p>The compiler performs the tokenization, so this method works only
     * inside a running macro.
     *
     * @param source the source code
     * @return the tokens of {@code source}
     * @throws IllegalStateException if called outside a running macro
     */
    static TokenStream parse(String source) {
        return Bridge.lex(source);
    }

    /**
     * Returns a stream that contains a single token.
     *
     * @param token the token
     * @return a new stream containing {@code token}
     */
    static TokenStream of(Token token) {
        TokenStream stream = new TokenStream();
        stream.add(token);
        return stream;
    }

    /**
     * Returns the number of tokens in this stream.
     *
     * @return the number of tokens
     */
    int size() {
        return this.tokens.size();
    }

    /**
     * Returns whether this stream contains no tokens.
     *
     * @return {@code true} if {@link #size} is 0
     */
    boolean isEmpty() {
        return this.tokens.size() == 0;
    }

    /**
     * Returns the token at the specified position.
     *
     * @param index the index of the token
     * @return the token
     * @throws IndexOutOfBoundsException if {@code index} is negative or not
     *         less than {@link #size}
     */
    Token get(int index) {
        return this.tokens.get(index);
    }

    /**
     * Appends a token to the end of this stream.
     *
     * @param token the token to append
     */
    mut void add(Token token) {
        this.tokens.add(token);
    }

    /**
     * Inserts a token at the specified position.
     *
     * @param index the index to insert at; {@link #size} appends
     * @param token the token to insert
     * @throws IndexOutOfBoundsException if {@code index} is negative or
     *         greater than {@link #size}
     */
    mut void insert(int index, Token token) {
        this.tokens.add(index, token);
    }

    /**
     * Removes the token at the specified position.
     *
     * @param index the index of the token
     * @return the removed token
     * @throws IndexOutOfBoundsException if {@code index} is negative or not
     *         less than {@link #size}
     */
    mut Token remove(int index) {
        return this.tokens.remove(index);
    }

    /**
     * Appends the tokens of another stream to the end of this stream.
     *
     * @param other the tokens to append
     */
    mut void addAll(&TokenStream other) {
        for (int i = 0; i < other.size(); i++) {
            this.tokens.add(other.get(i));
        }
    }

    /**
     * Parses source code and appends its tokens to the end of this stream.
     *
     * <pre>{@code
     * out.append("return this.");
     * out.add(name);
     * out.append(";");
     * }</pre>
     *
     * @param source the source code to append
     * @throws IllegalStateException if called outside a running macro
     */
    mut void append(String source) {
        TokenStream parsed = TokenStream.parse(source);
        this.addAll(&parsed);
    }

    /**
     * Inserts the tokens of another stream at the specified position.
     *
     * @param index the index to insert at; {@link #size} appends
     * @param other the tokens to insert
     * @throws IndexOutOfBoundsException if {@code index} is negative or
     *         greater than {@link #size}
     */
    mut void insertAll(int index, &TokenStream other) {
        for (int i = 0; i < other.size(); i++) {
            this.tokens.add(index + i, other.get(i));
        }
    }

    /**
     * Returns a copy of a range of tokens.
     *
     * @param begin the index of the first token, inclusive
     * @param end the index after the last token, exclusive
     * @return a new stream containing the tokens in the range
     * @throws IndexOutOfBoundsException unless
     *         {@code 0 <= begin <= end <= size()}
     */
    TokenStream slice(int begin, int end) {
        if (begin < 0 || end > this.size() || begin > end) {
            throw new IndexOutOfBoundsException(
                "slice " + begin + ".." + end + " of " + this.size() + " tokens");
        }
        TokenStream part = new TokenStream();
        for (int i = begin; i < end; i++) {
            part.add(this.get(i));
        }
        return part;
    }

    /**
     * Returns the index of the first token with the specified text.
     *
     * @param text the text to search for
     * @return the index of the first matching token, or -1 if there is none
     */
    int indexOf(String text) {
        return this.indexOf(text, 0);
    }

    /**
     * Returns the index of the first token with the specified text, starting
     * the search at the specified index.
     *
     * @param text the text to search for
     * @param from the index to start the search at
     * @return the index of the first matching token at or after {@code from},
     *         or -1 if there is none
     */
    int indexOf(String text, int from) {
        for (int i = from; i < this.size(); i++) {
            if (this.get(i).text().equals(&text)) {
                return i;
            }
        }
        return -1;
    }

    /**
     * Returns the index of the last token with the specified text.
     *
     * @param text the text to search for
     * @return the index of the last matching token, or -1 if there is none
     */
    int lastIndexOf(String text) {
        for (int i = this.size() - 1; i >= 0; i--) {
            if (this.get(i).text().equals(&text)) {
                return i;
            }
        }
        return -1;
    }

    /**
     * Returns the index of the bracket that closes the bracket at the
     * specified position.
     *
     * <p>Works for {@code (}, {@code [}, <code>{</code> and {@code <}. For
     * {@code <}, a {@code >>} or {@code >>>} token closes two or three angle
     * brackets at once, as in {@code Map<String, List<int>>}.
     *
     * @param open the index of the opening bracket
     * @return the index of the closing bracket, or -1 if it is never closed
     * @throws IllegalArgumentException if the token at {@code open} is not one
     *         of these brackets
     */
    int matching(int open) {
        String opening = this.get(open).text();
        String closing = closer(opening);
        int depth = 0;
        for (int i = open; i < this.size(); i++) {
            Token token = this.get(i);
            if (token.kind() != Token.Kind.PUNCT) {
                continue;
            }
            if (token.text().equals(&opening)) {
                depth++;
            } else if (token.text().equals(&closing)) {
                depth--;
            } else if (opening.equals(&"<") && token.text().equals(&">>")) {
                depth = depth - 2;
            } else if (opening.equals(&"<") && token.text().equals(&">>>")) {
                depth = depth - 3;
            } else {
                continue;
            }
            if (depth <= 0) {
                return i;
            }
        }
        return -1;
    }

    /**
     * Returns a copy of this stream.
     *
     * @return a new stream containing the same tokens
     */
    TokenStream copy() {
        return this.slice(0, this.size());
    }

    /**
     * Returns an iterator over the tokens of this stream, in order.
     *
     * @return an iterator that borrows this stream
     */
    @Override
    Iterator<Token> iterator() {
        return this.tokens.iterator();
    }

    /**
     * Returns the text of the tokens, separated by single spaces.
     *
     * @return the tokens as text
     */
    @Override
    String toString() {
        String text = "";
        for (int i = 0; i < this.size(); i++) {
            if (i > 0) {
                text = text + " ";
            }
            text = text + this.get(i).text();
        }
        return text;
    }

    private static String closer(String opening) {
        if (opening.equals(&"(")) {
            return ")";
        }
        if (opening.equals(&"[")) {
            return "]";
        }
        if (opening.equals(&"{")) {
            return "}";
        }
        if (opening.equals(&"<")) {
            return ">";
        }
        throw new IllegalArgumentException("`" + opening + "` does not open a group");
    }
}
