package std.macros;

/**
 * A token of source code: an identifier, a literal, a punctuation token
 * or a doc comment.
 *
 * <p>{@code text} is exactly what the source contains, so a string literal
 * keeps its quotes and escape sequences: the literal {@code "a\n"} has the
 * five characters {@code "a\n"} as its text. Tokens created by the static
 * factory methods of this class have the span of the macro invocation;
 * tokens read from the input keep their location in the source.
 *
 * @param kind the kind of token
 * @param text the source text of the token
 * @param span the location of the token
 */
record Token(TokenKind kind, String text, Span span) {
    /**
     * Creates an identifier or keyword token. The name is not validated.
     *
     * @param name the identifier
     * @return the token
     */
    static Token ident(String name) {
        return new Token(TokenKind.IDENT, name, Span.callSite());
    }

    /**
     * Creates a punctuation token, such as {@code ;} or {@code ->}. The text
     * is not validated.
     *
     * @param text the punctuation
     * @return the token
     */
    static Token punct(String text) {
        return new Token(TokenKind.PUNCT, text, Span.callSite());
    }

    /**
     * Creates a literal token from its source text, such as {@code 42},
     * {@code 'x'} or {@code "done"}.
     *
     * <p>Use {@link #string} to create a string literal from a value.
     *
     * @param text the source text of the literal
     * @return the token
     */
    static Token literal(String text) {
        return new Token(TokenKind.LITERAL, text, Span.callSite());
    }

    /**
     * Creates a string literal with the specified value.
     *
     * <p>Quotes, backslashes and control characters are escaped: a value that
     * contains a tab produces a literal with {@code \t} written in it.
     *
     * @param value the value of the literal
     * @return the token
     */
    static Token string(String value) {
        String text = "\"";
        for (char c : value.chars()) {
            if (c == '"') {
                text = text + "\\\"";
            } else if (c == '\\') {
                text = text + "\\\\";
            } else if (c == '\n') {
                text = text + "\\n";
            } else if (c == '\t') {
                text = text + "\\t";
            } else if (c == '\r') {
                text = text + "\\r";
            } else {
                text = text + c;
            }
        }
        return literal(text + "\"");
    }

    /**
     * Returns whether this token is an identifier or keyword.
     *
     * @return {@code true} for an identifier or keyword
     */
    boolean isIdent() {
        return this.kind == TokenKind.IDENT;
    }

    /**
     * Returns whether this token is the specified identifier or keyword.
     *
     * @param name the identifier to test
     * @return {@code true} if this token is {@code name}
     */
    boolean isIdent(String name) {
        return this.kind == TokenKind.IDENT && this.text.equals(&name);
    }

    /**
     * Returns whether this token is the specified punctuation.
     *
     * @param text the punctuation to test
     * @return {@code true} if this token is {@code text}
     */
    boolean isPunct(String text) {
        return this.kind == TokenKind.PUNCT && this.text.equals(&text);
    }

    /**
     * Returns whether this token is a literal.
     *
     * @return {@code true} for a literal
     */
    boolean isLiteral() {
        return this.kind == TokenKind.LITERAL;
    }

    /**
     * Returns whether this token is a doc comment.
     *
     * @return {@code true} for a doc comment
     */
    boolean isDoc() {
        return this.kind == TokenKind.DOC;
    }

    /**
     * Returns a copy of this token at another location, so that errors in
     * code built from it point there.
     *
     * @param span the new location
     * @return the relocated token
     */
    Token withSpan(Span span) {
        return new Token(this.kind, this.text, span);
    }

    /**
     * Returns the source text of this token.
     *
     * @return the text of this token
     */
    @Override
    String toString() {
        return this.text;
    }
}
