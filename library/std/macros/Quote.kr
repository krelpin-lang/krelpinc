package std.macros;

import std.util.HashMap;
import std.util.Map;

/**
 * A code template with {@code #name} placeholders, which is easier to read
 * than building code token by token.
 *
 * <p>Each placeholder is replaced by the tokens set for it. A {@code #}
 * inside a string or character literal in the template is not a
 * placeholder.
 *
 * <pre>{@code
 * Quote getter = new Quote("#type #getter() { return this.#name; }");
 * getter.set("type", &field.type());
 * getter.set("name", field.name());
 * getter.ident("getter", "get" + capitalized);
 * TokenStream code = getter.render();
 * }</pre>
 *
 * <p>A placeholder always stands for whole tokens: {@code get#name} is the
 * name {@code get} followed by the field's name, not a single longer name.
 * Build such names with {@link #ident}, as above.
 */
final class Quote {
    private final String template;
    private final Map<String, TokenStream> values;

    /**
     * Constructs a quote from a template, with no placeholders set.
     *
     * @param template the source code of the template
     */
    Quote(String template) {
        this.template = template;
        this.values = new HashMap<>();
    }

    /**
     * Sets a placeholder to a sequence of tokens.
     *
     * @param name the name of the placeholder, without the {@code #}
     * @param tokens the tokens to substitute, which are copied
     */
    mut void set(String name, &TokenStream tokens) {
        this.values.put(name, tokens.copy());
    }

    /**
     * Sets a placeholder to a single token.
     *
     * @param name the name of the placeholder, without the {@code #}
     * @param token the token to substitute
     */
    mut void set(String name, Token token) {
        this.values.put(name, TokenStream.of(token));
    }

    /**
     * Sets a placeholder to an identifier.
     *
     * @param name the name of the placeholder, without the {@code #}
     * @param text the identifier to substitute
     */
    mut void ident(String name, String text) {
        this.set(name, Token.ident(text));
    }

    /**
     * Sets a placeholder to a string literal.
     *
     * @param name the name of the placeholder, without the {@code #}
     * @param value the value of the string literal
     */
    mut void string(String name, String value) {
        this.set(name, Token.string(value));
    }

    /**
     * Returns the tokens of the template with every placeholder replaced.
     *
     * @return the rendered tokens
     * @throws MacroError if the template uses a placeholder that was not set
     * @throws IllegalStateException if called outside a running macro
     */
    TokenStream render() {
        char[] chars = this.template.chars();
        String source = "";
        char quote = ' ';
        boolean quoted = false;
        int i = 0;
        while (i < chars.length) {
            char c = chars[i];
            if (quoted) {
                source = source + c;
                if (c == '\\' && i + 1 < chars.length) {
                    source = source + chars[i + 1];
                    i = i + 2;
                    continue;
                }
                quoted = c != quote;
                i++;
                continue;
            }
            if (c == '"' || c == '\'') {
                quoted = true;
                quote = c;
                source = source + c;
                i++;
                continue;
            }
            if (c == '#' && i + 1 < chars.length
                    && (chars[i + 1].isLetter() || chars[i + 1] == '_')) {
                int j = i + 1;
                String name = "";
                while (j < chars.length && (chars[j].isLetterOrDigit() || chars[j] == '_')) {
                    name = name + chars[j];
                    j++;
                }
                if (!this.values.containsKey(&name)) {
                    throw new MacroError("`#" + name + "` is used in a quote but never set");
                }
                source = source + " " + Quote.MARKER + name + " ";
                i = j;
                continue;
            }
            source = source + c;
            i++;
        }
        TokenStream parsed = TokenStream.parse(source);
        TokenStream out = new TokenStream();
        for (int k = 0; k < parsed.size(); k++) {
            Token token = parsed.get(k);
            if (token.isIdent() && token.text().startsWith(Quote.MARKER)) {
                String name = token.text().substring(Quote.MARKER.length());
                (&TokenStream)? value = this.values.get(&name);
                if (value != null) {
                    out.addAll(value);
                }
            } else {
                out.add(token);
            }
        }
        return out;
    }

    private static final String MARKER = "__krelpin_quote_";
}
