package std.crypto;

final class Sha512 {
    private static final long[] ROUND = {
        0x428a2f98d728ae22L, 0x7137449123ef65cdL, 0xb5c0fbcfec4d3b2fL, 0xe9b5dba58189dbbcL,
        0x3956c25bf348b538L, 0x59f111f1b605d019L, 0x923f82a4af194f9bL, 0xab1c5ed5da6d8118L,
        0xd807aa98a3030242L, 0x12835b0145706fbeL, 0x243185be4ee4b28cL, 0x550c7dc3d5ffb4e2L,
        0x72be5d74f27b896fL, 0x80deb1fe3b1696b1L, 0x9bdc06a725c71235L, 0xc19bf174cf692694L,
        0xe49b69c19ef14ad2L, 0xefbe4786384f25e3L, 0x0fc19dc68b8cd5b5L, 0x240ca1cc77ac9c65L,
        0x2de92c6f592b0275L, 0x4a7484aa6ea6e483L, 0x5cb0a9dcbd41fbd4L, 0x76f988da831153b5L,
        0x983e5152ee66dfabL, 0xa831c66d2db43210L, 0xb00327c898fb213fL, 0xbf597fc7beef0ee4L,
        0xc6e00bf33da88fc2L, 0xd5a79147930aa725L, 0x06ca6351e003826fL, 0x142929670a0e6e70L,
        0x27b70a8546d22ffcL, 0x2e1b21385c26c926L, 0x4d2c6dfc5ac42aedL, 0x53380d139d95b3dfL,
        0x650a73548baf63deL, 0x766a0abb3c77b2a8L, 0x81c2c92e47edaee6L, 0x92722c851482353bL,
        0xa2bfe8a14cf10364L, 0xa81a664bbc423001L, 0xc24b8b70d0f89791L, 0xc76c51a30654be30L,
        0xd192e819d6ef5218L, 0xd69906245565a910L, 0xf40e35855771202aL, 0x106aa07032bbd1b8L,
        0x19a4c116b8d2d0c8L, 0x1e376c085141ab53L, 0x2748774cdf8eeb99L, 0x34b0bcb5e19b48a8L,
        0x391c0cb3c5c95a63L, 0x4ed8aa4ae3418acbL, 0x5b9cca4f7763e373L, 0x682e6ff3d6b2b8a3L,
        0x748f82ee5defb2fcL, 0x78a5636f43172f60L, 0x84c87814a1f0ab72L, 0x8cc702081a6439ecL,
        0x90befffa23631e28L, 0xa4506cebde82bde9L, 0xbef9a3f7b2c67915L, 0xc67178f2e372532bL,
        0xca273eceea26619cL, 0xd186b8c721c0c207L, 0xeada7dd6cde0eb1eL, 0xf57d4f7fee6ed178L,
        0x06f067aa72176fbaL, 0x0a637dc5a2c898a6L, 0x113f9804bef90daeL, 0x1b710b35131c471bL,
        0x28db77f523047d84L, 0x32caab7b40c72493L, 0x3c9ebe0a15c9bebcL, 0x431d67c49c100d4cL,
        0x4cc5d4becb3e42b6L, 0x597f299cfc657e2aL, 0x5fcb6fab3ad6faecL, 0x6c44198c4a475817L
    };

    private final long[] state;
    private final byte[] block;
    private final long[] words;
    private int filled;
    private long length;

    Sha512() {
        this.state = new long[8];
        this.block = new byte[128];
        this.words = new long[80];
        this.filled = 0;
        this.length = 0L;
        this.reset();
    }

    static byte[] hash(&byte[] data) {
        Sha512 digest = new Sha512();
        digest.update(data);
        return digest.digest();
    }

    static byte[] hash(String text) {
        return Sha512.hash(&text.bytes());
    }

    mut void update(&byte[] data) {
        for (int index = 0; index < data.length; index++) {
            this.push(data[index]);
        }
        this.length += (long) data.length;
    }

    mut void update(String text) {
        this.update(&text.bytes());
    }

    mut byte[] digest() {
        long bits = this.length * 8L;
        long high = this.length >>> 61;
        this.push((byte) 0x80);
        while (this.filled != 112) {
            this.push((byte) 0);
        }
        for (int shift = 56; shift >= 0; shift -= 8) {
            this.push((byte) (high >>> shift));
        }
        for (int shift = 56; shift >= 0; shift -= 8) {
            this.push((byte) (bits >>> shift));
        }
        byte[] out = new byte[64];
        for (int index = 0; index < 8; index++) {
            long value = this.state[index];
            for (int part = 0; part < 8; part++) {
                out[index * 8 + part] = (byte) (value >>> (56 - part * 8));
            }
        }
        this.reset();
        return out;
    }

    mut void reset() {
        this.state[0] = 0x6a09e667f3bcc908L;
        this.state[1] = 0xbb67ae8584caa73bL;
        this.state[2] = 0x3c6ef372fe94f82bL;
        this.state[3] = 0xa54ff53a5f1d36f1L;
        this.state[4] = 0x510e527fade682d1L;
        this.state[5] = 0x9b05688c2b3e6c1fL;
        this.state[6] = 0x1f83d9abfb41bd6bL;
        this.state[7] = 0x5be0cd19137e2179L;
        this.filled = 0;
        this.length = 0L;
    }

    private mut void push(byte value) {
        this.block[this.filled] = value;
        this.filled++;
        if (this.filled == 128) {
            this.compress();
            this.filled = 0;
        }
    }

    private mut void compress() {
        for (int index = 0; index < 16; index++) {
            long word = 0L;
            for (int part = 0; part < 8; part++) {
                word = (word << 8) | ((long) this.block[index * 8 + part] & 0xFFL);
            }
            this.words[index] = word;
        }
        for (int index = 16; index < 80; index++) {
            long early = this.words[index - 15];
            long late = this.words[index - 2];
            long s0 = Sha512.rotate(early, 1) ^ Sha512.rotate(early, 8) ^ (early >>> 7);
            long s1 = Sha512.rotate(late, 19) ^ Sha512.rotate(late, 61) ^ (late >>> 6);
            this.words[index] = this.words[index - 16] + s0 + this.words[index - 7] + s1;
        }
        long a = this.state[0];
        long b = this.state[1];
        long c = this.state[2];
        long d = this.state[3];
        long e = this.state[4];
        long f = this.state[5];
        long g = this.state[6];
        long h = this.state[7];
        for (int index = 0; index < 80; index++) {
            long sum1 = Sha512.rotate(e, 14) ^ Sha512.rotate(e, 18) ^ Sha512.rotate(e, 41);
            long choose = (e & f) ^ (~e & g);
            long first = h + sum1 + choose + Sha512.ROUND[index] + this.words[index];
            long sum0 = Sha512.rotate(a, 28) ^ Sha512.rotate(a, 34) ^ Sha512.rotate(a, 39);
            long majority = (a & b) ^ (a & c) ^ (b & c);
            long second = sum0 + majority;
            h = g;
            g = f;
            f = e;
            e = d + first;
            d = c;
            c = b;
            b = a;
            a = first + second;
        }
        this.state[0] += a;
        this.state[1] += b;
        this.state[2] += c;
        this.state[3] += d;
        this.state[4] += e;
        this.state[5] += f;
        this.state[6] += g;
        this.state[7] += h;
    }

    private static long rotate(long value, int bits) {
        return (value >>> bits) | (value << (64 - bits));
    }
}
