package std.crypto;

final class Sha256 {
    private static final int[] ROUND = {
        0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
        0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
        0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
        0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
        0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
        0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
        0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
        0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
    };

    private final int[] state;
    private final byte[] block;
    private final int[] words;
    private int filled;
    private long length;

    Sha256() {
        this.state = new int[8];
        this.block = new byte[64];
        this.words = new int[64];
        this.filled = 0;
        this.length = 0L;
        this.reset();
    }

    static byte[] hash(&byte[] data) {
        Sha256 digest = new Sha256();
        digest.update(data);
        return digest.digest();
    }

    static byte[] hash(String text) {
        return Sha256.hash(&text.bytes());
    }

    mut void update(&byte[] data) {
        int index = 0;
        while (index < data.length) {
            if (this.filled == 0 && data.length - index >= 64) {
                this.loadData(data, index);
                this.compress();
                index += 64;
            } else {
                this.push(data[index]);
                index++;
            }
        }
        this.length += (long) data.length;
    }

    mut void copyFrom(&Sha256 other) {
        for (int index = 0; index < 8; index++) {
            this.state[index] = other.state[index];
        }
        for (int index = 0; index < other.filled; index++) {
            this.block[index] = other.block[index];
        }
        this.filled = other.filled;
        this.length = other.length;
    }

    mut void update(String text) {
        this.update(&text.bytes());
    }

    mut byte[] digest() {
        long bits = this.length * 8L;
        this.push((byte) 0x80);
        while (this.filled != 56) {
            this.push((byte) 0);
        }
        for (int shift = 56; shift >= 0; shift -= 8) {
            this.push((byte) (bits >>> shift));
        }
        byte[] out = new byte[32];
        for (int index = 0; index < 8; index++) {
            int value = this.state[index];
            out[index * 4] = (byte) (value >>> 24);
            out[index * 4 + 1] = (byte) (value >>> 16);
            out[index * 4 + 2] = (byte) (value >>> 8);
            out[index * 4 + 3] = (byte) value;
        }
        this.reset();
        return out;
    }

    mut void reset() {
        this.state[0] = 0x6a09e667;
        this.state[1] = 0xbb67ae85;
        this.state[2] = 0x3c6ef372;
        this.state[3] = 0xa54ff53a;
        this.state[4] = 0x510e527f;
        this.state[5] = 0x9b05688c;
        this.state[6] = 0x1f83d9ab;
        this.state[7] = 0x5be0cd19;
        this.filled = 0;
        this.length = 0L;
    }

    private mut void push(byte value) {
        this.block[this.filled] = value;
        this.filled++;
        if (this.filled == 64) {
            this.loadBlock();
            this.compress();
            this.filled = 0;
        }
    }

    private mut void loadBlock() {
        for (int index = 0; index < 16; index++) {
            this.words[index] = ((this.block[index * 4] & 0xFF) << 24)
                | ((this.block[index * 4 + 1] & 0xFF) << 16)
                | ((this.block[index * 4 + 2] & 0xFF) << 8)
                | (this.block[index * 4 + 3] & 0xFF);
        }
    }

    private mut void loadData(&byte[] data, int offset) {
        for (int index = 0; index < 16; index++) {
            int at = offset + index * 4;
            this.words[index] = ((data[at] & 0xFF) << 24)
                | ((data[at + 1] & 0xFF) << 16)
                | ((data[at + 2] & 0xFF) << 8)
                | (data[at + 3] & 0xFF);
        }
    }

    private mut void compress() {
        for (int index = 16; index < 64; index++) {
            int early = this.words[index - 15];
            int late = this.words[index - 2];
            int s0 = Sha256.rotate(early, 7) ^ Sha256.rotate(early, 18) ^ (early >>> 3);
            int s1 = Sha256.rotate(late, 17) ^ Sha256.rotate(late, 19) ^ (late >>> 10);
            this.words[index] = this.words[index - 16] + s0 + this.words[index - 7] + s1;
        }
        int a = this.state[0];
        int b = this.state[1];
        int c = this.state[2];
        int d = this.state[3];
        int e = this.state[4];
        int f = this.state[5];
        int g = this.state[6];
        int h = this.state[7];
        for (int index = 0; index < 64; index++) {
            int sum1 = Sha256.rotate(e, 6) ^ Sha256.rotate(e, 11) ^ Sha256.rotate(e, 25);
            int choose = (e & f) ^ (~e & g);
            int first = h + sum1 + choose + Sha256.ROUND[index] + this.words[index];
            int sum0 = Sha256.rotate(a, 2) ^ Sha256.rotate(a, 13) ^ Sha256.rotate(a, 22);
            int majority = (a & b) ^ (a & c) ^ (b & c);
            int second = sum0 + majority;
            h = g;
            g = f;
            f = e;
            e = d + first;
            d = c;
            c = b;
            b = a;
            a = first + second;
        }
        this.state[0] += a;
        this.state[1] += b;
        this.state[2] += c;
        this.state[3] += d;
        this.state[4] += e;
        this.state[5] += f;
        this.state[6] += g;
        this.state[7] += h;
    }

    private static int rotate(int value, int bits) {
        return (value >>> bits) | (value << (32 - bits));
    }
}
