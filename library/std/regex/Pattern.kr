package std.regex;

import std.util.ArrayList;
import std.util.List;

final class Pattern {
    private final String source;
    private boolean caseInsensitive;
    private boolean multiline;
    private boolean dotAll;
    private final char[] text;
    private int at;
    private int groups;
    private final List<String> names;
    private final List<int> nameGroups;
    private final List<CharClass> classes;
    private final List<Node> nodes;
    private final List<Inst> program;

    private Pattern(String regex, &Flag[] flags) {
        this.text = regex.chars();
        this.source = regex;
        this.caseInsensitive = false;
        this.multiline = false;
        this.dotAll = false;
        for (int index = 0; index < flags.length; index++) {
            this.enable(flags[index]);
        }
        this.at = 0;
        this.groups = 0;
        this.names = new ArrayList<>();
        this.nameGroups = new ArrayList<>();
        this.classes = new ArrayList<>();
        this.nodes = new ArrayList<>();
        this.program = new ArrayList<>();
        int root = this.parseAlternation();
        if (this.at < this.text.length) {
            throw this.error("unmatched closing ')'");
        }
        this.program.add(Inst.Save(0));
        this.emitNode(root);
        this.program.add(Inst.Save(1));
        this.program.add(Inst.Match);
    }

    static Pattern compile(String regex, Flag... flags) {
        return new Pattern(regex, &flags);
    }

    static boolean matches(String regex, &String input) {
        Pattern pattern = Pattern.compile(regex);
        Matcher matcher = pattern.matcher(input);
        return matcher.matches();
    }

    static String quote(&String text) {
        StringBuilder quoted = new StringBuilder();
        for (char c : text.chars()) {
            if ("\\.[]{}()<>*+-=!?^$|".contains(c)) {
                quoted.append('\\');
            }
            quoted.append(c);
        }
        return quoted.toString();
    }

    String pattern() {
        return this.source;
    }

    List<Flag> flags() {
        List<Flag> enabled = new ArrayList<>();
        if (this.caseInsensitive) {
            enabled.add(Flag.CASE_INSENSITIVE);
        }
        if (this.multiline) {
            enabled.add(Flag.MULTILINE);
        }
        if (this.dotAll) {
            enabled.add(Flag.DOTALL);
        }
        return enabled;
    }

    Matcher matcher(&String input) borrows this {
        return new Matcher(this, input);
    }

    List<String> split(&String input) {
        return this.split(input, 0);
    }

    List<String> split(&String input, int limit) {
        List<String> parts = new ArrayList<>();
        Matcher matcher = this.matcher(input);
        int last = 0;
        while ((limit <= 0 || parts.size() < limit - 1) && matcher.find()) {
            if (matcher.end() == 0) {
                continue;
            }
            parts.add(input.substring(last, matcher.start()));
            last = matcher.end();
        }
        parts.add(input.substring(last));
        if (limit == 0) {
            while (parts.size() > 1 && parts.get(parts.size() - 1).isEmpty()) {
                parts.remove(parts.size() - 1);
            }
        }
        return parts;
    }

    @Override
    String toString() {
        return this.source;
    }

    private mut void enable(Flag flag) {
        switch (flag) {
            case CASE_INSENSITIVE -> this.caseInsensitive = true;
            case MULTILINE -> this.multiline = true;
            case DOTALL -> this.dotAll = true;
        }
    }

    private PatternSyntaxException error(String description) {
        return new PatternSyntaxException(description, this.source, this.at);
    }

    private boolean more() {
        return this.at < this.text.length;
    }

    private char peek() {
        return this.text[this.at];
    }

    private mut boolean accept(char c) {
        if (this.more() && this.peek() == c) {
            this.at++;
            return true;
        }
        return false;
    }
    private mut int add(Node node) {
        this.nodes.add(node);
        return this.nodes.size() - 1;
    }

    private mut int parseAlternation() {
        List<int> branches = new ArrayList<>();
        branches.add(this.parseConcat());
        while (this.accept('|')) {
            branches.add(this.parseConcat());
        }
        if (branches.size() == 1) {
            return branches.get(0);
        }
        return this.add(Node.Alternate(branches));
    }

    private mut int parseConcat() {
        List<int> items = new ArrayList<>();
        while (this.more() && this.peek() != '|' && this.peek() != ')') {
            int item = this.parseRepeat();
            if (item >= 0) {
                items.add(item);
            }
        }
        return this.add(Node.Concat(items));
    }

    private mut int parseRepeat() {
        int atom = this.parseAtom();
        if (atom < 0) {
            return atom;
        }
        if (this.more()) {
            int min;
            int max;
            char c = this.peek();
            if (c == '*') {
                min = 0;
                max = -1;
                this.at++;
            } else if (c == '+') {
                min = 1;
                max = -1;
                this.at++;
            } else if (c == '?') {
                min = 0;
                max = 1;
                this.at++;
            } else if (c == '{') {
                this.at++;
                min = this.parseNumber();
                max = min;
                if (this.accept(',')) {
                    max = this.more() && this.peek() != '}' ? this.parseNumber() : -1;
                }
                if (!this.accept('}')) {
                    throw this.error("unclosed counted repetition");
                }
                if (max >= 0 && max < min) {
                    throw this.error("illegal repetition range");
                }
            } else {
                return atom;
            }
            boolean lazy = this.accept('?');
            if (this.more() && this.peek() == '+') {
                throw this.error("possessive quantifiers are not supported");
            }
            return this.add(Node.Repeat(atom, min, max, lazy));
        }
        return atom;
    }

    private mut int parseNumber() {
        int start = this.at;
        int value = 0;
        while (this.more() && this.peek().isDigit() && (int) this.peek() < 128) {
            value = value * 10 + ((int) this.peek() - (int) '0');
            this.at++;
        }
        if (this.at == start) {
            throw this.error("expected a number in counted repetition");
        }
        return value;
    }

    private mut int parseAtom() {
        char c = this.peek();
        if (c == '(') {
            this.at++;
            return this.parseGroup();
        }
        if (c == '[') {
            this.at++;
            return this.add(Node.CharSet(this.parseClass()));
        }
        if (c == '.') {
            this.at++;
            return this.add(Node.Any);
        }
        if (c == '^') {
            this.at++;
            return this.add(Node.Anchor(Assertion.LINE_START));
        }
        if (c == '$') {
            this.at++;
            return this.add(Node.Anchor(Assertion.LINE_END));
        }
        if (c == '\\') {
            this.at++;
            return this.parseEscape();
        }
        if (c == '*' || c == '+' || c == '?' || c == '{') {
            throw this.error("dangling meta character '$c'");
        }
        this.at++;
        return this.add(Node.Literal(c));
    }

    private mut int parseGroup() {
        int group = -1;
        if (this.accept('?')) {
            if (this.accept(':')) {
                group = -1;
            } else if (this.more() && this.peek() == '<' && this.at + 1 < this.text.length
                    && this.text[this.at + 1] != '=' && this.text[this.at + 1] != '!') {
                this.at++;
                StringBuilder name = new StringBuilder();
                while (this.more() && this.peek() != '>') {
                    name.append(this.peek());
                    this.at++;
                }
                if (!this.accept('>')) {
                    throw this.error("unclosed group name");
                }
                this.groups++;
                group = this.groups;
                this.names.add(name.toString());
                this.nameGroups.add(group);
            } else if (this.more() && (this.peek() == '=' || this.peek() == '!' || this.peek() == '<')) {
                throw this.error("lookaround is not supported");
            } else {
                while (this.more() && this.peek() != ')' && this.peek() != ':') {
                    char flag = this.peek();
                    if (flag == 'i') {
                        this.caseInsensitive = true;
                    } else if (flag == 's') {
                        this.dotAll = true;
                    } else if (flag == 'm') {
                        this.multiline = true;
                    } else {
                        throw this.error("unknown inline flag '$flag'");
                    }
                    this.at++;
                }
                if (this.accept(')')) {
                    return -1;
                }
                if (!this.accept(':')) {
                    throw this.error("unclosed group");
                }
            }
        } else {
            this.groups++;
            group = this.groups;
        }
        int inner = this.parseAlternation();
        if (!this.accept(')')) {
            throw this.error("unclosed group");
        }
        return this.add(Node.Group(group, inner));
    }

    private mut int parseEscape() {
        if (!this.more()) {
            throw this.error("trailing backslash");
        }
        char c = this.peek();
        this.at++;
        if (c == 'b') {
            return this.add(Node.Anchor(Assertion.WORD_EDGE));
        }
        if (c == 'B') {
            return this.add(Node.Anchor(Assertion.NOT_WORD_EDGE));
        }
        if (c == 'A') {
            return this.add(Node.Anchor(Assertion.TEXT_START));
        }
        if (c == 'z' || c == 'Z') {
            return this.add(Node.Anchor(Assertion.TEXT_END));
        }
        if ("dDwWsS".contains(c)) {
            CharClass set = new CharClass();
            Pattern.addShorthand(&mut set, c);
            this.classes.add(set);
            return this.add(Node.CharSet(this.classes.size() - 1));
        }
        if (c.isDigit()) {
            throw this.error("back references are not supported");
        }
        return this.add(Node.Literal((char) this.escapedChar(c)));
    }

    private mut int escapedChar(char c) {
        if (c == 'n') {
            return 10;
        }
        if (c == 't') {
            return 9;
        }
        if (c == 'r') {
            return 13;
        }
        if (c == 'f') {
            return 12;
        }
        if (c == 'e') {
            return 27;
        }
        if (c == '0') {
            return 0;
        }
        if (c == 'x' || c == 'u') {
            int digits = c == 'x' ? 2 : 4;
            int value = 0;
            for (int index = 0; index < digits; index++) {
                if (!this.more() || this.peek().digit(16) < 0) {
                    throw this.error("illegal hexadecimal escape");
                }
                value = value * 16 + this.peek().digit(16);
                this.at++;
            }
            return value;
        }
        if (c.isLetterOrDigit()) {
            throw this.error("illegal escape '\\$c'");
        }
        return (int) c;
    }

    private static void addShorthand(&mut CharClass set, char c) {
        CharClass base = new CharClass();
        char lower = c.toLowerCase();
        if (lower == 'd') {
            base.addDigits();
        } else if (lower == 'w') {
            base.addWord();
        } else {
            base.addSpace();
        }
        if (c == lower) {
            set.addAll(&base);
        } else {
            set.addComplement(&base);
        }
    }

    private mut int parseClass() {
        CharClass set = new CharClass();
        if (this.accept('^')) {
            set.negate();
        }
        boolean first = true;
        while (true) {
            if (!this.more()) {
                throw this.error("unclosed character class");
            }
            char c = this.peek();
            if (c == ']' && !first) {
                this.at++;
                break;
            }
            first = false;
            this.at++;
            int low;
            if (c == '\\') {
                if (!this.more()) {
                    throw this.error("unclosed character class");
                }
                char escaped = this.peek();
                if ("dDwWsS".contains(escaped)) {
                    this.at++;
                    Pattern.addShorthand(&mut set, escaped);
                    continue;
                }
                this.at++;
                low = this.escapedChar(escaped);
            } else if (c == '[') {
                throw this.error("nested character classes are not supported");
            } else {
                low = (int) c;
            }
            int high = low;
            if (this.at + 1 < this.text.length && this.peek() == '-' && this.text[this.at + 1] != ']') {
                this.at++;
                char end = this.peek();
                this.at++;
                if (end == '\\') {
                    if (!this.more()) {
                        throw this.error("unclosed character class");
                    }
                    char escaped = this.peek();
                    this.at++;
                    high = this.escapedChar(escaped);
                } else {
                    high = (int) end;
                }
                if (high < low) {
                    throw this.error("illegal character range");
                }
            }
            set.addRange(low, high);
        }
        this.classes.add(set);
        return this.classes.size() - 1;
    }

    private mut void emitNode(int index) {
        Node node = this.nodes.get(index).clone();
        switch (node) {
            case Literal(char c) -> this.program.add(Inst.Char(this.caseInsensitive ? c.toLowerCase() : c));
            case Any -> this.program.add(Inst.Any);
            case CharSet(int set) -> this.program.add(Inst.CharSet(set));
            case Anchor(Assertion kind) -> this.program.add(Inst.Check(kind));
            case Group(int group, int inner) -> {
                if (group >= 0) {
                    this.program.add(Inst.Save(2 * group));
                }
                this.emitNode(inner);
                if (group >= 0) {
                    this.program.add(Inst.Save(2 * group + 1));
                }
            }
            case Concat(List<int> items) -> {
                for (int item : items) {
                    this.emitNode(item);
                }
            }
            case Alternate(List<int> branches) -> this.emitAlternation(&branches);
            case Repeat(int body, int min, int max, boolean lazy) -> this.emitRepeat(body, min, max, lazy);
        }
    }

    private mut void emitAlternation(&List<int> branches) {
        List<int> jumps = new ArrayList<>();
        int last = branches.size() - 1;
        for (int index = 0; index < last; index++) {
            int split = this.placeholder();
            this.emitNode(branches.get(index));
            jumps.add(this.placeholder());
            this.program.set(split, Inst.Split(split + 1, this.program.size()));
        }
        this.emitNode(branches.get(last));
        for (int jump : jumps) {
            this.program.set(jump, Inst.Jump(this.program.size()));
        }
    }

    private mut void emitRepeat(int body, int min, int max, boolean lazy) {
        for (int index = 0; index < min; index++) {
            this.emitNode(body);
        }
        if (max < 0) {
            int split = this.placeholder();
            this.emitNode(body);
            this.program.add(Inst.Jump(split));
            this.program.set(split, Pattern.branch(split + 1, this.program.size(), lazy));
            return;
        }
        List<int> splits = new ArrayList<>();
        for (int index = min; index < max; index++) {
            splits.add(this.placeholder());
            this.emitNode(body);
        }
        for (int split : splits) {
            this.program.set(split, Pattern.branch(split + 1, this.program.size(), lazy));
        }
    }

    private mut int placeholder() {
        this.program.add(Inst.Match);
        return this.program.size() - 1;
    }

    private static Inst branch(int body, int exit, boolean lazy) {
        return lazy ? Inst.Split(exit, body) : Inst.Split(body, exit);
    }

    private int[]? run(&char[] input, int start, boolean wholeInput, &mut boolean[] visited) {
        int length = input.length;
        int[] slots = new int[2 * (this.groups + 1)];
        for (int index = 0; index < slots.length; index++) {
            slots[index] = -1;
        }
        List<int> stack = new ArrayList<>();
        stack.add(0);
        stack.add(start);
        while (!stack.isEmpty()) {
            int second = stack.remove(stack.size() - 1);
            int first = stack.remove(stack.size() - 1);
            if (first < 0) {
                slots[-first - 1] = second;
                continue;
            }
            int pc = first;
            int at = second;
            boolean alive = true;
            while (alive) {
                int seen = pc * (length + 1) + at;
                if (visited[seen]) {
                    break;
                }
                visited[seen] = true;
                switch (this.program.get(pc)) {
                    case Char(char expected) -> {
                        alive = at < length && this.same(input[at], expected);
                        pc++;
                        at++;
                    }
                    case Any -> {
                        alive = at < length && (input[at] != '\n' || this.dotAll);
                        pc++;
                        at++;
                    }
                    case CharSet(int set) -> {
                        alive = at < length && this.classes.get(set).matches(input[at], this.caseInsensitive);
                        pc++;
                        at++;
                    }
                    case Split(int preferred, int alternative) -> {
                        stack.add(alternative);
                        stack.add(at);
                        pc = preferred;
                    }
                    case Jump(int target) -> pc = target;
                    case Save(int slot) -> {
                        stack.add(-slot - 1);
                        stack.add(slots[slot]);
                        slots[slot] = at;
                        pc++;
                    }
                    case Check(Assertion kind) -> {
                        alive = this.holds(kind, input, at);
                        pc++;
                    }
                    case Match -> {
                        if (!wholeInput || at == length) {
                            return slots;
                        }
                        alive = false;
                    }
                }
            }
        }
        return null;
    }

    private boolean holds(Assertion kind, &char[] input, int at) {
        int length = input.length;
        return switch (kind) {
            case LINE_START -> at == 0 || (this.multiline && input[at - 1] == '\n');
            case LINE_END -> at == length || (this.multiline && input[at] == '\n');
            case TEXT_START -> at == 0;
            case TEXT_END -> at == length;
            case WORD_EDGE, NOT_WORD_EDGE -> {
                boolean before = at > 0 && Pattern.isWord(input[at - 1]);
                boolean after = at < length && Pattern.isWord(input[at]);
                yield (before != after) == (kind == Assertion.WORD_EDGE);
            }
        };
    }

    private boolean same(char c, char expected) {
        return c == expected || (this.caseInsensitive && c.toLowerCase() == expected);
    }

    private static boolean isWord(char c) {
        return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
    }

    private int groupNamed(String name) {
        for (int index = 0; index < this.names.size(); index++) {
            if (this.names.get(index).equals(&name)) {
                return this.nameGroups.get(index);
            }
        }
        throw new IllegalArgumentException("no group named `$name`");
    }

    static final class Matcher borrows src {
        private final &Pattern pattern;
        private final String input;
        private final char[] chars;
        private int[] slots;
        private boolean matched;
        private int next;

        private Matcher(&Pattern pattern, &String input) keeps pattern {
            this.pattern = pattern;
            this.input = input.clone();
            this.chars = input.chars();
            this.slots = new int[0];
            this.matched = false;
            this.next = 0;
        }

        &Pattern pattern() borrows src {
            return this.pattern;
        }

        mut boolean matches() {
            return this.attempt(0, true, false);
        }

        mut boolean lookingAt() {
            return this.attempt(0, false, false);
        }

        mut boolean find() {
            if (this.next > this.chars.length) {
                this.matched = false;
                return false;
            }
            return this.attempt(this.next, false, true);
        }

        mut boolean find(int start) {
            if (start < 0 || start > this.chars.length) {
                throw new IndexOutOfBoundsException("start $start is out of bounds for length ${this.chars.length}");
            }
            return this.attempt(start, false, true);
        }

        mut void reset() {
            this.matched = false;
            this.next = 0;
        }

        int groupCount() {
            return this.pattern.groups;
        }

        String group() {
            String? text = this.group(0);
            if (text == null) {
                throw new IllegalStateException("no match found");
            }
            return text;
        }

        String? group(int group) {
            int start = this.start(group);
            if (start < 0) {
                return null;
            }
            return this.input.substring(start, this.end(group));
        }

        String? group(String name) {
            return this.group(this.pattern.groupNamed(name));
        }

        int start() {
            return this.start(0);
        }

        int end() {
            return this.end(0);
        }

        int start(int group) {
            return this.slot(2 * group, group);
        }

        int end(int group) {
            return this.slot(2 * group + 1, group);
        }

        int start(String name) {
            return this.start(this.pattern.groupNamed(name));
        }

        int end(String name) {
            return this.end(this.pattern.groupNamed(name));
        }

        mut String replaceAll(String replacement) {
            return this.replace(&replacement, true);
        }

        mut String replaceFirst(String replacement) {
            return this.replace(&replacement, false);
        }

        mut List<String> results() {
            List<String> found = new ArrayList<>();
            this.reset();
            while (this.find()) {
                found.add(this.group());
            }
            return found;
        }

        private int slot(int index, int group) {
            if (!this.matched) {
                throw new IllegalStateException("no match found");
            }
            if (group < 0 || group > this.pattern.groups) {
                throw new IndexOutOfBoundsException("no group $group");
            }
            return this.slots[index];
        }

        private mut boolean attempt(int from, boolean whole, boolean scan) {
            int length = this.chars.length;
            boolean[] visited = new boolean[this.pattern.program.size() * (length + 1)];
            int start = from;
            while (start <= length) {
                int[]? found = this.pattern.run(&this.chars, start, whole, &mut visited);
                if (found != null) {
                    int end = found[1];
                    this.next = end == found[0] ? end + 1 : end;
                    this.slots = found;
                    this.matched = true;
                    return true;
                }
                if (!scan) {
                    break;
                }
                start++;
            }
            this.matched = false;
            this.next = length + 1;
            return false;
        }

        private mut String replace(&String replacement, boolean every) {
            this.reset();
            StringBuilder out = new StringBuilder();
            int last = 0;
            while (this.find()) {
                out.append(this.input.substring(last, this.start()));
                this.appendReplacement(&mut out, replacement);
                last = this.end();
                if (!every) {
                    break;
                }
            }
            out.append(this.input.substring(last));
            return out.toString();
        }

        private void appendReplacement(&mut StringBuilder out, &String replacement) {
            char[] chars = replacement.chars();
            int index = 0;
            while (index < chars.length) {
                char c = chars[index];
                if (c == '\\' && index + 1 < chars.length) {
                    out.append(chars[index + 1]);
                    index += 2;
                } else if (c == '$' && index + 1 < chars.length && chars[index + 1] == '{') {
                    int close = index + 2;
                    StringBuilder name = new StringBuilder();
                    while (close < chars.length && chars[close] != '}') {
                        name.append(chars[close]);
                        close++;
                    }
                    String? value = this.group(name.toString());
                    if (value != null) {
                        out.append(value);
                    }
                    index = close + 1;
                } else if (c == '$' && index + 1 < chars.length && chars[index + 1].isDigit()) {
                    int group = (int) chars[index + 1] - (int) '0';
                    String? value = this.group(group);
                    if (value != null) {
                        out.append(value);
                    }
                    index += 2;
                } else {
                    out.append(c);
                    index++;
                }
            }
        }
    }

    private static final class CharClass {
        private final List<int> lows;
        private final List<int> highs;
        private boolean negated;

        CharClass() {
            this.lows = new ArrayList<>();
            this.highs = new ArrayList<>();
            this.negated = false;
        }

        mut void negate() {
            this.negated = !this.negated;
        }

        mut void addRange(int low, int high) {
            this.lows.add(low);
            this.highs.add(high);
        }

        mut void addAll(&CharClass other) {
            for (int index = 0; index < other.lows.size(); index++) {
                this.addRange(other.lows.get(index), other.highs.get(index));
            }
        }

        mut void addDigits() {
            this.addRange((int) '0', (int) '9');
        }

        mut void addWord() {
            this.addRange((int) '0', (int) '9');
            this.addRange((int) 'A', (int) 'Z');
            this.addRange((int) '_', (int) '_');
            this.addRange((int) 'a', (int) 'z');
        }

        mut void addSpace() {
            this.addRange(9, 13);
            this.addRange((int) ' ', (int) ' ');
        }

        mut void addComplement(&CharClass sorted) {
            int next = 0;
            for (int index = 0; index < sorted.lows.size(); index++) {
                int low = sorted.lows.get(index);
                if (low > next) {
                    this.addRange(next, low - 1);
                }
                next = Math.max(next, sorted.highs.get(index) + 1);
            }
            if (next <= 1114111) {
                this.addRange(next, 1114111);
            }
        }

        boolean matches(char c, boolean ignoreCase) {
            boolean found = this.contains((int) c);
            if (!found && ignoreCase) {
                found = this.contains((int) c.toLowerCase()) || this.contains((int) c.toUpperCase());
            }
            return found != this.negated;
        }

        private boolean contains(int code) {
            for (int index = 0; index < this.lows.size(); index++) {
                if (code >= this.lows.get(index) && code <= this.highs.get(index)) {
                    return true;
                }
            }
            return false;
        }
    }

    enum Flag {
        CASE_INSENSITIVE,
        MULTILINE,
        DOTALL
    }

    private enum Assertion {
        LINE_START,
        LINE_END,
        WORD_EDGE,
        NOT_WORD_EDGE,
        TEXT_START,
        TEXT_END
    }

    private enum Node {
        Literal(char c),
        Any,
        CharSet(int index),
        Anchor(Assertion kind),
        Group(int index, int inner),
        Concat(List<int> items),
        Alternate(List<int> branches),
        Repeat(int body, int min, int max, boolean lazy)
    }

    private enum Inst {
        Char(char c),
        Any,
        CharSet(int index),
        Split(int preferred, int alternative),
        Jump(int target),
        Save(int slot),
        Check(Assertion kind),
        Match
    }
}
