import std.sync.AtomicInt;
import std.task.Context;
import std.task.Future;
import std.task.Poll;
import std.task.Unit;
import std.task.Waker;
import std.util.ArrayList;
import std.util.List;

// A waker that counts how often it is woken.
class CountingWaker implements Waker {
    public static final AtomicInt WOKEN = new AtomicInt(0);

    CountingWaker() {}

    @Override
    void wake() {
        CountingWaker.WOKEN.addAndGet(1);
    }

    @Override
    Waker copy() {
        return new CountingWaker();
    }
}

// Pending once, then ready: gives other tasks a turn.
class YieldOnce implements Future<Unit> {
    private boolean yielded = false;

    YieldOnce() {}

    @Override
    mut Poll<Unit> poll(&mut Context cx) {
        if (this.yielded) {
            return Poll.Ready(new Unit());
        }
        this.yielded = true;
        cx.waker().wake();
        return Poll.Pending;
    }
}

class Never implements Future<int> {
    Never() {}

    @Override
    mut Poll<int> poll(&mut Context cx) {
        return Poll.Pending;
    }
}

// A minimal executor: polls one future until it is ready.
class Executor {
    static <T> T run(Future<T> future) throws Exception {
        Context cx = new Context(new CountingWaker());
        while (true) {
            Poll<T> poll = future.poll(&mut cx);
            switch (poll) {
                case Ready(T value) -> {
                    return value;
                }
                case Pending -> {}
            }
        }
    }

    // Polls the tasks in turn until every one is finished.
    static void runAll(List<Future<Unit>> tasks) throws Exception {
        Context cx = new Context(new CountingWaker());
        while (!tasks.isEmpty()) {
            Future<Unit> task = tasks.remove(0);
            Poll<Unit> poll = task.poll(&mut cx);
            switch (poll) {
                case Ready(Unit unit) -> {}
                case Pending -> tasks.add(task);
            }
        }
    }
}

class Bad extends Exception {
    Bad(String message) { super(message); }
}

class Counter {
    private int count = 0;
    private List<String> log = new ArrayList<>();

    mut async int bump(String why) {
        await new YieldOnce();
        this.count++;
        this.log.add(why);
        return this.count;
    }

    String describe() {
        return "${this.count} ${this.log}";
    }
}

interface Source {
    Future<String> fetch(int n);
}

class Doubler implements Source {
    @Override
    Future<String> fetch(int n) {
        return Doubler.make(n);
    }

    static async String make(int n) {
        await new YieldOnce();
        return "fetched ${n * 2}";
    }
}

class Main {
    static async <T> T identity(T value) {
        await new YieldOnce();
        return value;
    }

    static async int thrower() throws Bad {
        await new YieldOnce();
        throw new Bad("from inside");
    }

    static async String catches() {
        String result = "none";
        try {
            int x = await Main.thrower();
            result = "got $x";
        } catch (Bad e) {
            result = "caught ${e.getMessage()}";
        } finally {
            Console.println("finally ran");
        }
        await new YieldOnce();
        return result;
    }

    static async String earlyReturn(int n) {
        try {
            if (n > 0) {
                await new YieldOnce();
                return "positive";
            }
        } finally {
            Console.println("leaving earlyReturn($n)");
        }
        return "not positive";
    }

    static async void counting(&mut Counter counter) {
        await counter.bump("one");
        await counter.bump("two");
    }

    // Locals live across `await`, and references to them stay valid.
    static async String keepsLocals() {
        List<String> names = new ArrayList<>();
        names.add("a");
        &List<String> view = &names;
        int before = view.size();
        await new YieldOnce();
        names.add("b");
        String first = names.get(0);
        int length = await Main.borrowed(&first);
        return "$names $before $length";
    }

    static async int borrowed(&String text) {
        await new YieldOnce();
        return text.length() + 10;
    }

    static async void worker(String name, int rounds) {
        for (int i = 0; i < rounds; i++) {
            Console.println("$name round $i");
            await new YieldOnce();
        }
    }

    static void main() throws Exception {
        Console.println(Executor.run(Main.identity("generic")));
        Console.println(Executor.run(Main.identity(42)));
        Console.println(Executor.run(Main.catches()));
        Console.println(Executor.run(Main.earlyReturn(1)));
        Console.println(Executor.run(Main.earlyReturn(0)));
        Console.println(Executor.run(Main.keepsLocals()));

        Counter counter = new Counter();
        Executor.run(Main.counting(&mut counter));
        Console.println(counter.describe());

        Source source = new Doubler();
        Console.println(Executor.run(source.fetch(21)));

        List<Future<Unit>> tasks = new ArrayList<>();
        tasks.add(Main.worker("first", 3));
        tasks.add(Main.worker("second", 2));
        Executor.runAll(tasks);

        // Calling an `async` method runs nothing; dropping the future
        // cancels it.
        Future<int> neverPolled = Main.thrower();

        Future<int> future = Main.identity(7);
        Context cx = new Context(new CountingWaker());
        Console.println(future.poll(&mut cx));
        Console.println(future.poll(&mut cx));
        try {
            future.poll(&mut cx);
        } catch (IllegalStateException e) {
            Console.println("polled again: ${e.getMessage()}");
        }

        Future<int> never = new Never();
        Console.println(never.poll(&mut cx));
        Console.println("woken ${CountingWaker.WOKEN.get()} times");
    }
}
