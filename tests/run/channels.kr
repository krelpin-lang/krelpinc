import std.sync.AtomicInt;
import std.sync.Channel;
import std.sync.Mutex;
import std.sync.MutexGuard;
import std.util.ArrayList;
import std.util.List;

class Main {
    static final Channel<int> JOBS = new Channel<>(2);
    static final Channel<String> RESULTS = new Channel<>();
    static final AtomicInt DONE = new AtomicInt(0);
    static final Mutex<int[]> READY = new Mutex<>(new int[1]);

    static void worker(int id) {
        while (true) {
            int? job = Main.JOBS.receive();
            if (job == null) {
                break;
            }
            Main.RESULTS.send("job " + job + " squared " + (job * job));
        }
        Main.DONE.increment();
        MutexGuard<int[]> guard = Main.READY.lock();
        guard.getMut()[0] += 1;
        Main.READY.notifyAll();
    }

    static void main() {
        List<Thread> workers = new ArrayList<>();
        for (int i = 0; i < 3; i++) {
            int id = i;
            Thread thread = new Thread(() -> Main.worker(id));
            thread.start();
            workers.add(thread);
        }
        for (int job = 1; job <= 6; job++) {
            Main.JOBS.send(job);
        }
        Main.JOBS.close();
        {
            MutexGuard<int[]> guard = Main.READY.lock();
            while (guard.get()[0] < 3) {
                guard.wait();
            }
        }
        List<String> lines = new ArrayList<>();
        while (true) {
            String? line = Main.RESULTS.tryReceive();
            if (line == null) {
                break;
            }
            lines.add(line);
        }
        lines.sort();
        Console.println(lines);
        Console.println(Main.DONE.get() + " " + Main.JOBS.isClosed() + " " + Main.JOBS.receive());
        Console.println(Main.RESULTS.receive(20L));
        MutexGuard<int[]> guard = Main.READY.lock();
        Console.println(guard.wait(10L));
        while (!workers.isEmpty()) {
            Thread thread = workers.remove(0);
            thread.join();
        }
        try {
            Main.JOBS.send(9);
        } catch (IllegalStateException e) {
            Console.println(e.getMessage());
        }
    }
}
