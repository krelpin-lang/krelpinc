import std.crypto.ChaCha20Poly1305;
import std.crypto.Pbkdf2;
import std.crypto.Sha512;
import std.util.Hex;

class Main {
    static void main() {
        Console.println(Hex.encode(&Sha512.hash("")).substring(0, 32));
        Console.println(Hex.encode(&Sha512.hash("abc")).substring(0, 32));
        String text = "";
        for (int i = 0; i < 1000; i++) {
            text += "a";
        }
        Console.println(Hex.encode(&Sha512.hash(text)).substring(0, 32));
        Console.println(Hex.encode(&Sha512.hash("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")).substring(0, 32));
        Console.println(Hex.encode(&Pbkdf2.deriveKey(&"passwd".bytes(), &"salt".bytes(), 1, 64)));
        Console.println(Hex.encode(&Pbkdf2.deriveKey(&"Password".bytes(), &"NaCl".bytes(), 1000, 32)));
        String stored = Pbkdf2.hashPassword("hunter2", 1000);
        Console.println(stored.startsWith("pbkdf2-sha256:1000:") + " " + Pbkdf2.verifyPassword("hunter2", stored) + " " + Pbkdf2.verifyPassword("hunter3", stored));
        try {
            Pbkdf2.verifyPassword("x", "garbage");
        } catch (IllegalArgumentException e) {
            Console.println(e.getMessage());
        }
        byte[] key = new byte[32];
        for (int i = 0; i < 32; i++) {
            key[i] = (byte) (0x80 + i);
        }
        byte[] nonce = Hex.decode("070000004041424344454647");
        byte[] aad = Hex.decode("50515253c0c1c2c3c4c5c6c7");
        String message = "Ladies and Gentlemen of the class of '99: If I could offer you only one tip for the future, sunscreen would be it.";
        ChaCha20Poly1305 cipher = new ChaCha20Poly1305(&key);
        byte[] sealed = cipher.encrypt(&nonce, &message.bytes(), &aad);
        String hex = Hex.encode(&sealed);
        Console.println(hex.substring(0, 32));
        Console.println(hex.substring(hex.length() - 32));
        byte[]? opened = cipher.decrypt(&nonce, &sealed, &aad);
        Console.println(opened != null && String.fromUtf8(&opened) == message);
        sealed[3] = (byte) (sealed[3] ^ 1);
        Console.println(cipher.decrypt(&nonce, &sealed, &aad) == null);
        ChaCha20Poly1305 fresh = new ChaCha20Poly1305(&ChaCha20Poly1305.newKey());
        byte[] box = fresh.seal(&"secret".bytes());
        byte[]? back = fresh.open(&box);
        Console.println(back != null && String.fromUtf8(&back) == "secret");
        Console.println(cipher.open(&box) == null);
    }
}
