record Limit(int value) {
    public static final Limit FIRST = new Limit(5);

    public static final Limit SECOND = Limit.make(7);

    public static final int MAX = 10;

    public static final String LABEL = "limit";

    Limit {
        if (value > Limit.MAX) {
            throw new IllegalArgumentException("${Limit.LABEL} $value is above ${Limit.MAX}");
        }
    }

    private static Limit make(int value) {
        return new Limit(value);
    }
}

class Main {
    static void main() {
        Console.println("${Limit.FIRST} ${Limit.SECOND} ${Limit.MAX}");
    }
}
