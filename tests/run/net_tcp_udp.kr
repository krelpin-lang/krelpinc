import std.io.IOException;
import std.net.UdpSocket.Datagram;
import std.net.SocketAddr;
import std.net.TcpListener;
import std.net.TcpStream;
import std.net.UdpSocket;

class Main {
    static void client(int port) {
        try {
            TcpStream stream = TcpStream.connect("127.0.0.1:$port");
            stream.write("hello\r\n");
            stream.write("wörld\n");
            Console.println("client got: ${stream.readLine()}");
            Console.println("client got: ${stream.readLine()}");
            byte[] raw = {1, 2, 3};
            stream.writeBytes(&raw);
            stream.write("tail without newline");
            stream.shutdownWrite();
            Console.println("client got rest: ${stream.readAll()}");
        } catch (IOException e) {
            Console.println("client failed: ${e.getMessage()}");
        }
    }

    static void main() throws IOException {
        TcpListener listener = TcpListener.bind("127.0.0.1:0");
        SocketAddr address = listener.localAddr();
        int port = address.port();
        Console.println("ip ${address.ip()}, port is positive: ${port > 0}");

        Thread thread = new Thread(() -> Main.client(port));
        thread.start();

        TcpStream connection = listener.accept();
        Console.println("peer ip: ${connection.peerAddr().ip()}");
        for (int i = 0; i < 2; i++) {
            String? line = connection.readLine();
            connection.write("echo: $line\n");
        }
        byte[] raw = connection.read(3);
        Console.println("server got bytes: ${raw.length} ${raw[0]} ${raw[2]}");
        String rest = connection.readAll();
        Console.println("server got rest: $rest");
        connection.write("bye");
        connection.shutdownWrite();
        thread.join();

        UdpSocket a = UdpSocket.bind("127.0.0.1:0");
        UdpSocket b = UdpSocket.bind("127.0.0.1:0");
        a.sendText("ping", b.localAddr().toString());
        Datagram message = b.receive(1500);
        Console.println("udp: ${message.text()} from a: ${message.sender().port() == a.localAddr().port()}");

        try {
            TcpStream.connect("not an address");
        } catch (IOException e) {
            Console.println(e.getMessage());
        }
        try {
            TcpListener.bind("127.0.0.1:$port");
        } catch (IOException e) {
            Console.println("rebinding a busy port fails");
        }
        try {
            TcpStream.connect("127.0.0.1:1");
        } catch (IOException e) {
            Console.println("connecting to a closed port fails");
        }
        b.setReadTimeout(50);
        try {
            b.receive(10);
        } catch (IOException e) {
            Console.println("receive gave up after the timeout");
        }
        Console.println(SocketAddr.parse("[::1]:8080"));
        byte[] utf8 = "hé".bytes();
        Console.println("${utf8.length} ${String.fromUtf8(&utf8)}");
    }
}
