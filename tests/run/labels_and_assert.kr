import std.util.List;

class Main {
    static int find(&int[][] grid, int target) {
        int found = -1;
        search:
        for (int row = 0; row < grid.length; row++) {
            for (int col = 0; col < grid[row].length; col++) {
                if (grid[row][col] == target) {
                    found = row * 10 + col;
                    break search;
                }
            }
        }
        return found;
    }

    static int firstEven(List<List<int>> groups) {
        outer:
        while (true) {
            for (List<int> group : groups) {
                for (int value : group) {
                    if (value % 2 == 0) {
                        return value;
                    }
                }
            }
            break outer;
        }
        return -1;
    }

    static String classify(int n) {
        String result = "";
        cases:
        switch (n % 3) {
            case 0 -> {
                if (n == 0) {
                    result = "zero";
                    break cases;
                }
                result = "three";
            }
            default -> result = "other";
        }
        return result;
    }

    static void main() {
        int[][] grid = { { 1, 2 }, { 3, 4 } };
        Console.println(find(&grid, 4) + " " + find(&grid, 9));
        int skipped = 0;
        rows:
        for (int i = 0; i < 4; i++) {
            int j = 0;
            while (j < 4) {
                j++;
                if (j == 2) {
                    skipped++;
                    continue rows;
                }
            }
        }
        Console.println("skipped " + skipped);
        Console.println(firstEven(List.of(List.of(1, 3), List.of(5, 8))));
        Console.println(classify(0) + " " + classify(3) + " " + classify(4));
        String name = "ada";
        assert name.length() == 3;
        assert name.length() > 0 : "empty";
        try {
            assert name.isEmpty() && !name.contains("\"x\"");
        } catch (AssertionError e) {
            Console.println(e.getMessage());
        }
        try {
            assert name.length() == 5 : "length was " + name.length();
        } catch (AssertionError e) {
            Console.println(e.getMessage());
        }
        try {
            assert grid[0][1] == -2 : 42;
        } catch (AssertionError e) {
            Console.println(e.getMessage());
        }
    }
}
