import std.function.Function;
import std.sync.Mutex;
import std.util.ArrayList;
import std.util.HashMap;
import std.util.List;
import std.util.Map;

class Main {
    static final Function<int, int> DOUBLE = x -> x * 2;
    static final Mutex<List<Runnable>> TASKS = new Mutex<>(new ArrayList<>());
    static final Mutex<Map<String, int>> COUNTS = new Mutex<>(new HashMap<>());

    static void register(Runnable task) keeps task {
        Mutex.Guard<List<Runnable>> guard = Main.TASKS.lock();
        guard.getMut().add(task);
    }

    static void main() {
        Main.register(move () -> Console.println("first"));
        String word = "owned";
        Main.register(move () -> Console.println(word));
        {
            Mutex.Guard<Map<String, int>> counts = Main.COUNTS.lock();
            String key = "ada";
            counts.getMut().put(key, 1);
            Console.println(counts.get().get(&"ada"));
        }
        Mutex.Guard<List<Runnable>> guard = Main.TASKS.lock();
        for (int i = 0; i < guard.get().size(); i++) {
            guard.getMut().getMut(i).run();
        }
        Console.println(Main.DOUBLE.apply(21));
    }
}
