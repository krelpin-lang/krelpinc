package school;

import std.io.IOException;
import std.util.ArrayList;
import std.util.HashMap;
import std.util.List;
import std.util.Map;

enum Grade {
    A,
    B,
    C;
}

class Student implements Comparable<Student> {
    public String name;
    Map<String, Grade> grades;

    Student(String name) {
        this.name = name;
        this.grades = new HashMap<>();
    }

    mut void grade(String course, Grade grade) {
        this.grades.put(course, grade);
    }

    String report(String course) {
        Grade? grade = this.grades.get(&course);
        if (grade == null) {
            return this.name + ": no grade for " + course;
        }
        return this.name + ": " + grade.name() + " (" + grade.ordinal() + ")";
    }

    @Override
    int compareTo(&Student other) {
        return this.name.compareTo(&other.name);
    }
}

class Main {
    static void main() throws IOException {
        List<Student> students = new ArrayList<>();
        students.add(new Student("Ayşe"));
        students.add(new Student("Mehmet"));

        int longest = 0;
        for (Student student : students) {
            longest = Math.max(longest, student.name.length());
            Console.println(student.report("math").toUpperCase());
        }

        String text = longest.toString();
        String? line = Console.readLine();
        if (line == null) {
            throw new IOException("no input");
        }
        Console.println("longest name: " + text + ", input: " + line.trim());
    }
}
