import std.io.IOException;
import std.task.Context;
import std.task.Future;
import std.task.Poll;
import std.task.Unit;

class Ready implements Future<Unit> {
    Ready() {}

    @Override
    mut Poll<Unit> poll(&mut Context cx) {
        return Poll.Ready(new Unit());
    }
}

abstract class Service {
    abstract async String fetch();
}

class Main {
    static async &String pick(&String a, &String b) borrows a {
        return a;
    }

    static int notAsync() {
        await new Ready();
        return 1;
    }

    static async void notAFuture(String? text) {
        int number = await 5;
        await text;
    }

    static async void inLambda() {
        Runnable task = () -> {
            await new Ready();
        };
    }

    static async void fails() throws IOException {
        throw new IOException("no");
    }

    static async void unhandled() {
        await Main.fails();
    }

    static void callingIsFine() {
        Future<Unit> future = Main.fails();
    }

    static void main() {}
}

class Failing implements Future<String> {
    Failing() {}

    @Override
    mut Poll<String> poll(&mut Context cx) throws IOException {
        throw new IOException("failed");
    }
}

class Base {
    async String fetch() {
        return "base";
    }

    Future<String> load() {
        return new Failing();
    }
}

class Sub extends Base {
    // Error: `await base.fetch()` relies on `Base.fetch` throwing nothing.
    @Override
    Future<String> fetch() {
        return new Failing();
    }

    // Fine: callers of `load` already expect anything from `poll`.
    @Override
    async String load() throws IOException {
        return "sub";
    }
}
