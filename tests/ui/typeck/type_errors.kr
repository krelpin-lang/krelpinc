class Wallet {
    static final int count = 0;
    long cents;
    String? note;

    Wallet(long cents) {
        this.cents = cents;
        this.note = null;
    }

    int total() {
        return this.cents;
    }

    boolean empty() {
        if (this.cents == 0) {
            return true;
        }
    }

    void bump() {
        Wallet.count++;
        int size = this.note.length();
        String text = null;
    }
}

class Main {
    static void main() {
        Wallet wallet = new Wallet("ten");
        long secret = wallet.cents;
        boolean wrong = wallet.empty() + 1;
    }
}
