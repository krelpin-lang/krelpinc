import std.util.List;

class Point {
    final int x;
    final String? label;
    final int y = 3;

    Point(int x, boolean twice) {
        this.x = x;
        if (twice) {
            this.x = 2;
        }
        this.y = 4;
    }

    Point(final int x) {
        if (x > 0) {
            this.x = x;
            return;
        }
        x = 3;
    }

    Point() {
        this(1, false);
        this.x = 9;
    }
}

