import std.io.IOException;
import std.util.ArrayList;
import std.util.List;

class Files {
    static String read(String path) throws IOException {
        if (path.isEmpty()) {
            throw new IOException("no path");
        }
        return path;
    }
}

class Base {
    void save() {}
}

class Cache extends Base {
    @Override
    void save() throws IOException {}
}

class Main {
    static void main() {
        String text = Files.read("notes.txt");

        try {
            Console.println(text);
        } catch (IOException e) {
        }

        List<String> paths = new ArrayList<>();
        paths.forEach(path -> Files.read(path));
    }

    static void safe() {
        try {
            String text = Files.read("notes.txt");
        } catch (IOException e) {
            Console.println(e.getMessage() ?: "unknown error");
        }
    }
}
