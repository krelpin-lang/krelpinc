package geometry;

import std.util.HashSet;

enum Shape {
    Circle(double radius),
    Rect(double width, double height),
    Empty;

    static final double PI = 3.14159;

    static Shape square(double side) {
        return Rect(side, side);
    }

    double area() {
        return switch (this) {
            case Circle(double r) -> Shape.PI * r * r;
            case Rect(double w, double h) -> w * h;
            case Empty -> 0.0;
        };
    }

    String describe() {
        return switch (this) {
            case Rect(double w, double h) when w == h -> "square";
            case Rect(_, _) -> "rectangle";
            case Circle(_) -> "circle";
            case Empty -> "nothing";
        };
    }
}

enum Tree<T> {
    Leaf(T value),
    Node(Tree<T> left, Tree<T> right),
    Empty;

    boolean isLeaf() {
        return this instanceof Leaf(_);
    }
}

enum Order {
    Placed(Shape item, int quantity),
    Cancelled(String reason),
    Delivered;
}

enum Direction {
    North,
    East,
    South,
    West;

    Direction turn() {
        return switch (this) {
            case North -> Direction.East;
            case East -> Direction.South;
            case South -> Direction.West;
            case West -> Direction.North;
        };
    }
}

class Drawing {
    static Tree<Shape> plant(Shape[] shapes) {
        Tree<Shape> tree = Tree.Empty;
        for (Shape shape : shapes) {
            tree = Tree.Node(tree, Tree.Leaf(shape));
        }
        return tree;
    }

    static String report(Order order) {
        switch (order) {
            case Placed(Shape.Circle(double r), int quantity) when r > 10.0 -> {
                return quantity + " big circles";
            }
            case Placed(Shape item, int quantity) -> {
                return quantity + " x " + item.describe();
            }
            case Cancelled(String reason) -> {
                return "cancelled: " + reason;
            }
            case Delivered -> {
                return "delivered";
            }
        }
    }

    static boolean sameWay(Direction a, Direction b) {
        HashSet<Direction> seen = new HashSet<>();
        seen.add(a);
        return a == b && seen.contains(&b);
    }
}
