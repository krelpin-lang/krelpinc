package shapes;

interface Shape extends Comparable<Shape> {
    static final int MAX_SIDES = 12;

    double area();

    String describe() {
        return switch (this.sides()) {
            case 3 -> "triangle";
            case 4 -> "quadrilateral";
            default -> {
                yield "polygon";
            }
        };
    }

    int sides();
}

record Point(double x, double y) implements Shape {
    Point {
        if (x < 0.0) {
            throw new IllegalArgumentException("x");
        }
    }

    double length() {
        return Math.sqrt(this.x * this.x + this.y * this.y);
    }
}

record Empty();

enum Paint {
    Solid(String hex),
    Gradient(String from, String to),
    Clear;

    static final String DEFAULT = "#000000";

    boolean isClear() {
        return this.ordinal() == 2;
    }
}

enum Result<T, E> {
    Ok(T value),
    Err(E error);
}

abstract class Polygon implements Shape {
    static final AtomicInt created = new AtomicInt(0);
    public static final AtomicInt drawn = new AtomicInt(0);

    Point[] points;

    abstract double area();

    final int sides() {
        return this.points.length;
    }
}
