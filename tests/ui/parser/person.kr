package example;

import example.test;

/** A person with a name. */
class Person {
    static final int MAX_NAME_LENGTH = 64;
    static final AtomicInt created = new AtomicInt(0);

    String name;
    String? nickname;

    Person(String name) {
        this.name = name;
        this.nickname = null;
        Person.created.increment();
    }

    &String getName() {
        return &this.name;
    }

    mut void rename(String newName) {
        this.name = newName;
    }

    int nicknameLength() {
        return this.nickname?.length() ?: 0;
    }
}

class Main {
    static void main() {
        Person p = new Person("Ali");
        p.rename("Veli");
        Console.println(p.getName());
    }
}
