class Account {
    int balance;
    static final int LIMIT = 1000;

    static int total() {
        return this.balance;
    }

    mut void deposit(int amount) {
        balance = balance + amount;
        audit();
        Strin note = null;
        int amount = 0;
    }

    void audit() {
        if (LIMIT > 0) {
            break;
        }
    }

    &String name() borrows other {
        return null;
    }
}
