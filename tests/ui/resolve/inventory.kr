package shop;

import std.sync.AtomicInt;
import std.util.ArrayList;
import std.util.List;

record Price(long cents) {}

interface Priced {
    &Price price();
}

enum Category {
    FOOD,
    TOOLS;
}

class Item implements Priced {
    static final AtomicInt created = new AtomicInt(0);
    static final int MAX_NAME = 32;

    String name;
    Category category;
    Price cost;

    Item(String name, Category category, Price cost) {
        this.name = name;
        this.category = category;
        this.cost = cost;
        Item.created.increment();
    }

    @Override
    &Price price() {
        return &this.cost;
    }

    &String label() {
        return &this.name;
    }

    String describe() {
        String kind = switch (this.category) {
            case FOOD -> "food";
            case TOOLS -> {
                yield "tool";
            }
        };
        return kind;
    }

    static int validate(String name) {
        if (name.length() > Item.MAX_NAME) {
            return 1;
        }
        return 0;
    }
}

class Main {
    static void main() {
        List<Item> items = new ArrayList<>();
        for (int i = 0; i < 3; i++) {
            &Object value = items.get(i);
            if (value instanceof Item item) {
                Console.println(item.describe());
            }
        }
        items.forEach(item -> Console.println(item.label()));
    }
}
